{% doc %}
  @param {string} [authenticity_token] - The authenticity token from the form; falls back to context.authenticity_token
  @param {string} [token] - The authenticity token value
{% enddoc %}
{% assign token = token | default: authenticity_token | default: context.authenticity_token %}
{% unless token %}
  <small>Liquid Error AuthenticityTokenNotFound</small>
{% endunless %}
<input type="hidden" name="authenticity_token" value="{{ token }}">
