{% liquid
  assign c = { "errors": {}, "valid": true }

<% attributes.forEach((attr, i) => { -%>
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: '<%= attr.name %>'
<% }); -%>

  assign object.valid = c.valid
  assign object.errors = c.errors

  return object
%}
