{% doc %}
  @description Resolve the active provider secret. Mirrors helpers/default_site_key: an
    explicit value always wins; otherwise falls back to the CAPTCHA_DEFAULT_SECRET constant.
    Only whitespace is trimmed — secrets are case-sensitive.
  @param {string} [secret] Explicit secret; used when present.
  @returns {string} secret — explicit value, else the CAPTCHA_DEFAULT_SECRET constant, else ''.
{% enddoc %}
{% liquid
  assign resolved = secret | strip
  assign resolved = resolved | default: context.constants.CAPTCHA_DEFAULT_SECRET | strip
  assign resolved = resolved | default: ''
  return resolved
%}
