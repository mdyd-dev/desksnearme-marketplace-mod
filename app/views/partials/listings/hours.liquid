{%- comment -%} params: building_raw, listing_raw {%- endcomment -%}
{%- liquid
  assign b_raw = building_raw | default: ''
  assign l_raw = listing_raw | default: ''
  assign fallback = '{"preset":"none"}'
  assign b_json = b_raw
  if b_json == blank
    assign b_json = fallback
  endif
  assign l_json = l_raw
  if l_json == blank
    assign l_json = fallback
  endif
-%}
{%- if b_raw != blank or l_raw != blank -%}
  {%- parse_json bh -%}{{ b_json | html_safe }}{%- endparse_json -%}
  {%- parse_json lh -%}{{ l_json | html_safe }}{%- endparse_json -%}
  {%- liquid
    assign l_same = false
    if lh.preset == 'same' or lh.days == blank
      assign l_same = true
    endif
  -%}
  <section class="listing-detail__hours">
    <h2>Hours</h2>
    <div class="hours-cols">
      <div class="hours-block">
        <h3>Building access</h3>
        {%- if bh.days != blank -%}
          {% render 'listings/hours_days', days_map: bh.days %}
        {%- else -%}
          <p class="muted hours-same">Not specified.</p>
        {%- endif -%}
      </div>
      <div class="hours-block">
        <h3>Space access</h3>
        {%- if l_same -%}
          <p class="muted hours-same">Same as building access hours.</p>
        {%- else -%}
          {% render 'listings/hours_days', days_map: lh.days %}
        {%- endif -%}
      </div>
    </div>
  </section>

  <style>
    .listing-detail__hours { margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid var(--line); }
    .listing-detail__hours h2 { font-size: var(--fs-lg); margin: 0 0 1.1rem; }
    .hours-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
    .hours-block h3 { font-size: var(--fs-sm); font-weight: 700; margin: 0 0 .5rem; }
    .hours-list { list-style: none; margin: 0; padding: 0; }
    .hours-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .35rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); }
    .hours-list li:last-child { border-bottom: 0; }
    .hours-list__day { color: var(--muted); }
    .hours-list__val { font-weight: 600; text-align: right; }
    .hours-same { margin: 0; font-size: var(--fs-sm); }
    @media (max-width: 640px) { .hours-cols { grid-template-columns: 1fr; gap: 1.5rem; } }
  </style>
{%- endif -%}