{%- liquid
  # The one space card. Used anywhere a listing appears as a card.
  # Pass `listing`; optional `index` (eager-loads the first three images),
  # `meta` (overrides the gray line under the title), `show_fav`, `cta`.
  assign cover = listing.covers.first
  assign idx = index | default: 99
  assign img_m = cover.photo.versions.m | default: cover.photo.url | replace: ' ', '%20' | replace: ',', '%2C'
  assign img_avif = cover.photo.versions.m_avif | replace: ' ', '%20' | replace: ',', '%2C'

  assign card_cta = cta | default: 'View desk'

  assign card_meta = meta
  if card_meta == blank
    assign loc = listing.city
    if listing.state != blank and listing.city != blank
      assign loc = listing.city | append: ', ' | append: listing.state
    endif
    if loc == blank
      assign loc = listing.address
    endif
    assign card_meta = listing.listing_type
    if loc != blank and card_meta != blank
      assign card_meta = card_meta | append: ' · ' | append: loc
    elsif loc != blank
      assign card_meta = loc
    endif
  endif

  capture card_href
    render 'listings/url', id: listing.id, title: listing.title
  endcapture
  capture card_price
    render 'listings/price', listing: listing
  endcapture
-%}
<article class="wcard">
  <div class="wcard__media">
    <a class="wcard__media-link" href="{{ card_href }}" tabindex="-1" aria-hidden="true">
      {%- if cover.photo -%}
        <picture>
          {%- if img_avif != blank -%}<source type="image/avif" srcset="{{ img_avif }}">{%- endif -%}
          <img class="wcard__img" src="{{ img_m }}" alt="" width="400" height="300"
               loading="{% if idx <= 3 %}eager{% else %}lazy{% endif %}" decoding="async">
        </picture>
      {%- else -%}
        <span class="img-ph img-ph--fill" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="15" rx="1.5"/><circle cx="8" cy="10" r="1.6"/><path d="M21 15.5l-4.6-4.6L7 20.5"/></svg>
        </span>
      {%- endif -%}
    </a>
    {%- if show_fav != false -%}{% render 'listings/favorite_button', listing_id: listing.id, variant: 'card' %}{%- endif -%}
  </div>
  <div class="wcard__body">
    <h3 class="wcard__title"><a href="{{ card_href }}">{{ listing.title }}</a></h3>
    {%- if card_meta != blank -%}<p class="wcard__meta">{{ card_meta }}</p>{%- endif -%}
    {%- if card_price != blank -%}<p class="wcard__price">{{ card_price | html_safe }}</p>{%- endif -%}
    <a class="wcard__link" href="{{ card_href }}">{{ card_cta }}<span aria-hidden="true"> →</span></a>
  </div>
</article>
