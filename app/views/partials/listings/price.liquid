{%- liquid
  # Shared price format: "from $1,000 /hour" — no decimals unless the rate is under $10.
  # Pass `listing`. Outputs nothing when no rate is set.
  assign p_amount = ''
  assign p_unit = ''
  if listing.price_hour
    assign p_amount = listing.price_hour
    assign p_unit = 'hour'
  elsif listing.price_day
    assign p_amount = listing.price_day
    assign p_unit = 'day'
  elsif listing.price_week
    assign p_amount = listing.price_week
    assign p_unit = 'week'
  elsif listing.price_month
    assign p_amount = listing.price_month
    assign p_unit = 'month'
  endif

  assign p_str = ''
  if p_unit != blank
    if p_amount < 10
      assign p_str = p_amount | advanced_format: '%.2f'
    else
      assign whole = p_amount | floor | append: ''
      assign chars_r = whole | split: '' | reverse
      assign grouped = ''
      for ch in chars_r
        assign grouped = ch | append: grouped
        assign m = forloop.index | modulo: 3
        if m == 0 and forloop.index < chars_r.size
          assign grouped = grouped | prepend: ','
        endif
      endfor
      assign p_str = grouped
    endif
  endif
-%}
{%- if p_str != blank -%}from ${{ p_str }} <span>/{{ p_unit }}</span>{%- endif -%}
