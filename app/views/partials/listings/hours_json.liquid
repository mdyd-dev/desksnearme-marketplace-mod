{%- comment -%} params: prefix ('building' | 'listing') {%- endcomment -%}
{%- liquid
  assign days = 'mon,tue,wed,thu,fri,sat,sun' | split: ','
  assign preset_key = prefix | append: '_preset'
  assign preset = context.params[preset_key] | default: 'weekdays_9_5'
  unless preset == '24_7' or preset == 'weekdays_9_5' or preset == 'custom' or preset == 'same'
    assign preset = 'weekdays_9_5'
  endunless
-%}
{"preset":{{ preset | json | html_safe }}{%- unless preset == 'same' -%},"days":{
{%- for d in days -%}
  {%- liquid
    assign closed = false
    assign open_t = '09:00'
    assign close_t = '17:00'
    if preset == '24_7'
      assign open_t = '00:00'
      assign close_t = '23:59'
    elsif preset == 'weekdays_9_5'
      if d == 'sat' or d == 'sun'
        assign closed = true
      endif
    else
      assign ck = prefix | append: '_' | append: d | append: '_closed'
      assign ok = prefix | append: '_' | append: d | append: '_open'
      assign clk = prefix | append: '_' | append: d | append: '_close'
      if context.params[ck] == 'on'
        assign closed = true
      endif
      assign open_t = context.params[ok] | default: '09:00'
      assign close_t = context.params[clk] | default: '17:00'
    endif
  -%}
  {%- unless forloop.first -%},{%- endunless -%}
  {{ d | json | html_safe }}:{"closed":{{ closed }},"open":{{ open_t | json | html_safe }},"close":{{ close_t | json | html_safe }}}
{%- endfor -%}
}{%- endunless -%}}