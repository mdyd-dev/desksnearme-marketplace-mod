{%- comment -%} params: prefix, legend, allow_same (bool), existing (raw JSON string) {%- endcomment -%}
{%- liquid
  assign days = 'mon,tue,wed,thu,fri,sat,sun' | split: ','
  assign day_labels = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ','
  assign raw = existing | default: ''
  if raw == blank
    if allow_same
      assign raw = '{"preset":"same"}'
    else
      assign raw = '{"preset":"weekdays_9_5"}'
    endif
  endif
-%}
{%- parse_json h -%}{{ raw }}{%- endparse_json -%}
{%- assign cur = h.preset | default: 'weekdays_9_5' -%}
<fieldset class="hours-fields">
  <legend>{{ legend }}</legend>
  <div class="hours-presets">
    {%- if allow_same -%}
      <label class="chip chip--sm"><input type="radio" name="{{ prefix }}_preset" value="same"{% if cur == 'same' %} checked{% endif %}><span>Same as building</span></label>
    {%- endif -%}
    <label class="chip chip--sm"><input type="radio" name="{{ prefix }}_preset" value="24_7"{% if cur == '24_7' %} checked{% endif %}><span>24/7</span></label>
    <label class="chip chip--sm"><input type="radio" name="{{ prefix }}_preset" value="weekdays_9_5"{% if cur == 'weekdays_9_5' %} checked{% endif %}><span>Weekdays 9–5</span></label>
    <label class="chip chip--sm"><input type="radio" name="{{ prefix }}_preset" value="custom"{% if cur == 'custom' %} checked{% endif %}><span>Custom</span></label>
  </div>

  <div class="hours-grid" data-hours-grid{% if cur != 'custom' %} hidden{% endif %}>
    {%- for d in days -%}
      {%- liquid
        assign idx = forloop.index0
        assign dd = h.days[d]
        assign is_closed = dd.closed
        assign o = dd.open | default: '09:00'
        assign c = dd.close | default: '17:00'
      -%}
      <div class="hours-row">
        <span class="hours-row__day">{{ day_labels[idx] }}</span>
        <label class="hours-row__closed">
          <input type="checkbox" name="{{ prefix }}_{{ d }}_closed" value="on"{% if is_closed %} checked{% endif %}>
          <span>Closed</span>
        </label>
        <input class="input input--time" type="time" name="{{ prefix }}_{{ d }}_open" value="{{ o }}" aria-label="{{ day_labels[idx] }} opening time">
        <span class="hours-row__sep">–</span>
        <input class="input input--time" type="time" name="{{ prefix }}_{{ d }}_close" value="{{ c }}" aria-label="{{ day_labels[idx] }} closing time">
      </div>
    {%- endfor -%}
  </div>
</fieldset>

<style>
  .hours-fields { border: 1px solid var(--line); border-radius: var(--r-sm); padding: 1rem; margin: 0 0 1.1rem; }
  .hours-fields legend { font-weight: 600; font-size: var(--fs-sm); padding: 0 .4rem; }
  .hours-presets { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .9rem; }
  .chip--sm span { font-size: var(--fs-xs); padding: .3rem .7rem; }
  .hours-grid[hidden] { display: none; }
  .hours-row { display: grid; grid-template-columns: 5.5rem 5rem 1fr auto 1fr; align-items: center; gap: .5rem; padding: .25rem 0; }
  .hours-row__day { font-size: var(--fs-sm); font-weight: 600; }
  .hours-row__closed { display: flex; align-items: center; gap: .3rem; font-size: var(--fs-xs); color: var(--muted); }
  .hours-row__sep { color: var(--muted); }
  .input--time { padding: .35rem .5rem; font-size: var(--fs-sm); }
  .hours-row:has(input[type="checkbox"]:checked) .input--time { opacity: .4; pointer-events: none; }
  @media (max-width: 560px) {
    .hours-row { grid-template-columns: 1fr 1fr; grid-template-areas: "day closed" "open close"; }
    .hours-row__day { grid-area: day; }
    .hours-row__closed { grid-area: closed; }
    .hours-row__sep { display: none; }
  }
</style>