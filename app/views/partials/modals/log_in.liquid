<div class="modal" id="modal-login" data-open="{% if context.params.login or context.params.login_error or context.params.confirmed or context.params.confirm_error or context.params.password_reset %}true{% else %}false{% endif %}" role="dialog" aria-modal="true" aria-labelledby="login-title">
  <div class="modal__backdrop" data-close-modal></div>
  <div class="modal__panel">
    <button class="modal__close" type="button" data-close-modal aria-label="Close">&times;</button>
    <h2 class="modal__title" id="login-title">Log in</h2>

    {% if context.params.password_reset %}
      <div class="flash flash--notice">Password updated — you can log in with your new password now.</div>
    {% elsif context.params.confirmed %}
      <div class="flash flash--notice">Email confirmed — you can log in now.</div>
    {% elsif context.params.login_error == 'unconfirmed' %}
      <div class="flash flash--alert">Please confirm your email before logging in. <a href="/check-email">Resend the link</a>.</div>
    {% elsif context.params.confirm_error %}
      <div class="flash flash--alert">That confirmation link is invalid or has expired. <a href="/check-email">Request a new one</a>.</div>
    {% elsif context.params.login_error %}
      <div class="flash flash--alert">Incorrect email or password. <a href="/forgot-password">Forgot your password?</a></div>
    {% endif %}

    <form action="/session/create" method="post" class="stack">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <div class="field">
        <label for="li-email">Email</label>
        <input class="input" id="li-email" type="email" name="email" required autocomplete="email">
      </div>
      <div class="field">
        <div class="field__labelrow">
          <label for="li-password">Password</label>
          <a class="field__link" href="/forgot-password">Forgot password?</a>
        </div>
        <div class="input-reveal">
          <input class="input" id="li-password" type="password" name="password" required autocomplete="current-password">
          <button class="input-reveal__btn" type="button" data-toggle-password="li-password" aria-label="Show password" aria-pressed="false">
            <svg class="ico-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg class="ico-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.24 4.24M9.9 5.2A9.6 9.6 0 0 1 12 5c6.5 0 10 7 10 7a17.3 17.3 0 0 1-3.22 3.88M6.1 6.1A17.3 17.3 0 0 0 2 12s3.5 7 10 7a9.6 9.6 0 0 0 3.9-.82"/></svg>
          </button>
        </div>
      </div>
      <button class="btn btn--primary btn--block" type="submit">Log in</button>
      <p class="text-center muted" style="font-size:var(--fs-sm);margin:.25rem 0 0;">
        New here?
        <a href="#" data-close-modal data-open-modal="signup">Create an account</a>
      </p>
    </form>
  </div>
</div>