{%- liquid
  assign last = nil
  assign unread = 0
  for m in msgs
    if m.conversation_id == convo.id
      unless last
        assign last = m
      endunless
      if m.recipient_id == uid and m.read == false
        assign unread = unread | plus: 1
      endif
    endif
  endfor

  assign preview = 'No messages yet'
  if last
    assign preview = last.body | strip | truncate: 70
  endif

  assign is_mine = false
  if last and last.sender_id == uid
    assign is_mine = true
  endif
-%}
<li class="msg-item">
  <a class="msg-row{% if unread > 0 %} msg-row--unread{% endif %}" href="/messages/{{ convo.id }}">
    {% include 'hosts/avatar', name: who, size: 'sm', image_url: who_avatar, variant: variant %}
    <span class="msg-row__body">
      <span class="msg-row__top">
        <span class="msg-row__title">{{ convo.listing_title | default: 'A space' }}</span>
        {%- if who_prefix != blank -%}<span class="msg-row__who">{{ who_prefix }} {{ who | default: 'someone' }}</span>{%- endif -%}
      </span>
      <span class="msg-row__preview">{% if is_mine %}You: {% endif %}{{ preview }}</span>
    </span>
    <span class="msg-row__meta">
      {%- if last -%}<span class="msg-row__time">{{ last.created_at | date: '%b %-d' }}</span>{%- endif -%}
      {%- if unread > 0 -%}<span class="count-badge">{{ unread }}</span>{%- endif -%}
    </span>
  </a>
  <form class="msg-item__act" action="/messages/{{ convo.id }}/archive" method="post">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <input type="hidden" name="on" value="{% if is_archived %}false{% else %}true{% endif %}">
    <button type="submit" title="{% if is_archived %}Move back to inbox{% else %}Archive{% endif %}"
            aria-label="{% if is_archived %}Move back to inbox{% else %}Archive{% endif %}">
      {%- if is_archived -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 14l-4-4 4-4"/><path d="M5 10h9a5 5 0 0 1 5 5v4"/></svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><path d="M5 8v11a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/><path d="M10 12h4"/></svg>
      {%- endif -%}
    </button>
  </form>
</li>