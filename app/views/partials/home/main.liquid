{%- liquid
  graphql gf = 'listings/featured', per_page: 3
  assign featured = gf.records.results
-%}

<section class="home-hero">
  <div class="home-hero__wrap">
    <div class="hero-card">
      <h1 class="hero-card__title">Find a space to work</h1>

      <form class="hsearch" action="/listings" method="get" role="search">
        <input type="hidden" name="lat" id="geo-lat">
        <input type="hidden" name="lng" id="geo-lng">
        <div class="hsearch__row place-search">
          <span class="hsearch__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          </span>
          <input id="near" name="near" type="text" placeholder="Search"
                 class="hsearch__input" autocomplete="off" spellcheck="false"
                 role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="hero-list"
                 aria-label="Search by city or address"
                 data-place-input data-lat-field="geo-lat" data-lng-field="geo-lng">
          <span class="hsearch__divider" aria-hidden="true"></span>
          <button class="hsearch__locate" type="button" data-geo-locate>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
            <span class="hsearch__locate-txt">Use my location</span>
          </button>
          <button class="hsearch__btn" type="submit">Search</button>
          <ul class="addr-list" id="hero-list" role="listbox" hidden></ul>
        </div>
      </form>
    </div>
  </div>
</section>

{%- if featured != blank -%}
<section class="home-featured">
  <div class="home-featured__wrap">
    <h2 class="home-featured__title">Featured workspaces</h2>
    <div class="home-featured__grid">
      {%- for l in featured -%}
        {% render 'listings/wcard', listing: l, index: forloop.index %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

<section class="home-band home-band--guest">
  <div class="container">
    <p class="home-band__eyebrow">For guests</p>
    <h2 class="home-band__title">Search &amp; Connect for Free</h2>
    <p class="home-band__sub">For guests, finding space and messaging hosts is always free &mdash; you only ever pay for the space itself.</p>
    <div class="home-band__grid">
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        </span>
        <h3 class="bcard__title">Search Near You</h3>
        <p class="bcard__text">Find desks, meeting rooms, and offices around you &mdash; by the hour, day, week, or month, with the price on every listing.</p>
      </div>
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z"/></svg>
        </span>
        <h3 class="bcard__title">Connect Directly</h3>
        <p class="bcard__text">Message the person who runs the space and work out the details yourself. No middleman, no booking fees.</p>
      </div>
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0l-7.18-7.19a2 2 0 0 1-.58-1.42V5a2 2 0 0 1 2-2h6.99a2 2 0 0 1 1.42.59l7.35 7.35a2 2 0 0 1 0 2.47z"/><circle cx="7.5" cy="7.5" r="1.3"/></svg>
        </span>
        <h3 class="bcard__title">Free for Guests</h3>
        <p class="bcard__text">Searching Desks Near Me and reaching out to hosts never costs you a thing &mdash; the platform is free to use.</p>
      </div>
    </div>
    <div class="home-band__cta">
      <a class="btn btn--pill" href="/listings">Browse spaces</a>
    </div>
  </div>
</section>

<section class="home-band home-band--host">
  <div class="container">
    <p class="home-band__eyebrow">For hosts</p>
    <h2 class="home-band__title">Put Your Empty Space to Work</h2>
    <p class="home-band__sub">List desks, rooms, and offices for free &mdash; and we never take a commission on what you earn.</p>
    <div class="home-band__grid">
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/></svg>
        </span>
        <h3 class="bcard__title">Earn From Empty Space</h3>
        <p class="bcard__text">Turn unused desks, meeting rooms, or offices into recurring income. Listing is free, and we take no commission on what you charge.</p>
      </div>
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><circle cx="12" cy="12.5" r="2.1"/><path d="M12 7.5v2.9M10.5 13.8 6.7 16.2M13.5 13.8l3.8 2.4"/></svg>
        </span>
        <h3 class="bcard__title">Reach the Right People</h3>
        <p class="bcard__text">Get found by professionals searching for space near you, and connect with complementary people and communities.</p>
      </div>
      <div class="bcard">
        <span class="bcard__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.13-7 10-4-1.87-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        <h3 class="bcard__title">Simple &amp; Secure</h3>
        <p class="bcard__text">Manage your listings, photos, and pricing from one dashboard, and review every inquiry before you say yes.</p>
      </div>
    </div>
    <div class="home-band__cta">
      {%- if context.current_user -%}
        <a class="btn btn--primary btn--pill" href="/account/listings">List your space</a>
      {%- else -%}
        <button class="btn btn--primary btn--pill" type="button" data-open-modal="signup">List your space</button>
      {%- endif -%}
    </div>
  </div>
</section>

<div class="container">
<section class="home-steps" id="how-it-works">
  <h2>How it works</h2>
  <p class="muted home-steps__lead">Whether you need a space for the day or have one sitting empty.</p>

  <div class="home-track">
    <div class="home-track__head">
      <h3 class="home-track__title">Looking for a space</h3>
      <a class="home-track__link" href="/listings">Browse spaces →</a>
    </div>
    <div class="home-steps__grid">
      <div class="home-step">
        <span class="home-step__num">1</span>
        <h4>Search near you</h4>
        <p class="muted">Type a city or address, or share your location, to see what's available around you.</p>
      </div>
      <div class="home-step">
        <span class="home-step__num">2</span>
        <h4>Compare what's there</h4>
        <p class="muted">Photos, rates, access hours, capacity, and amenities on every listing. Filter by space type, group size, or amenities, and see where the results sit on the map.</p>
      </div>
      <div class="home-step">
        <span class="home-step__num">3</span>
        <h4>Message the host</h4>
        <p class="muted">Create a free account and hit Inquire to open a direct message thread with whoever runs the space. Sort out dates, access, and payment between you — we never take a cut.</p>
      </div>
    </div>
  </div>

  <div class="home-track home-track--host">
    <div class="home-track__head">
      <h3 class="home-track__title">Listing a space</h3>
      {%- if context.current_user -%}
        <a class="home-track__link" href="/account/listings">List a space →</a>
      {%- else -%}
        <button class="home-track__link" type="button" data-open-modal="signup">List a space →</button>
      {%- endif -%}
    </div>
    <div class="home-steps__grid">
      <div class="home-step">
        <span class="home-step__num">1</span>
        <h4>Sign up and add your space</h4>
        <p class="muted">Choose “List a space” when you sign up, then add photos, the address, the space type, and a few words on what it's like to work there.</p>
      </div>
      <div class="home-step">
        <span class="home-step__num">2</span>
        <h4>Set rates, hours, and amenities</h4>
        <p class="muted">Charge by the hour, day, week, or month — whichever fits. Set the building's access hours, plus separate hours for the space itself if they differ.</p>
      </div>
      <div class="home-step">
        <span class="home-step__num">3</span>
        <h4>Publish when ready</h4>
        <p class="muted">Save as a draft while you work on it, then publish when it's ready — and unpublish anytime the space isn't free. Inquiries land in your messages.</p>
      </div>
    </div>
  </div>
</section>
</div>
