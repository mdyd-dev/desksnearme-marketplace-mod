{%- liquid
  assign av_name = name | default: 'Host' | strip
  assign av_parts = av_name | split: ' '
  assign av_initials = av_parts.first | slice: 0
  if av_parts.size > 1
    assign av_last_initial = av_parts.last | slice: 0
    assign av_initials = av_initials | append: av_last_initial
  endif
  assign av_initials = av_initials | upcase
  assign av_size = size | default: 'md'
  assign av_variant = ''
  if variant != blank
    assign av_variant = ' avatar--' | append: variant
  endif
-%}
{%- if image_url != blank -%}
  <img class="avatar avatar--{{ av_size }}{{ av_variant }}" src="{{ image_url }}" alt="" width="96" height="96">
{%- else -%}
  <span class="avatar avatar--{{ av_size }}{{ av_variant }}" aria-hidden="true">{{ av_initials }}</span>
{%- endif -%}