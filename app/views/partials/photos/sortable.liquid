{% comment %} params: photos (array of listing_photo records) {% endcomment %}
{%- if photos and photos.size > 0 -%}
<div class="photo-sort" data-photo-sort data-csrf="{{ context.authenticity_token }}">
  <p class="photo-sort__hint">{% if photos.size > 1 %}Drag to reorder — the first photo is the cover. Hover a photo to remove it.{% else %}This is your cover photo. Hover it to remove.{% endif %}</p>
  <ul class="photo-sort__list">
    {% for p in photos %}
      <li class="photo-sort__item" draggable="true" data-photo-id="{{ p.id }}">
        <img src="{{ p.photo.versions.sm | default: p.photo.url }}" alt="" draggable="false" width="92" height="92">
        {% if forloop.first %}<span class="photo-sort__cover">Cover</span>{% endif %}
        <button type="button" class="photo-sort__del" data-photo-del aria-label="Remove photo">×</button>
        <button type="button" class="photo-sort__nav photo-sort__nav--prev" aria-label="Move earlier">‹</button>
        <button type="button" class="photo-sort__nav photo-sort__nav--next" aria-label="Move later">›</button>
      </li>
    {% endfor %}
  </ul>
  <span class="photo-sort__status" data-photo-sort-status aria-live="polite"></span>
</div>

<script type="module" src="{{ 'scripts/photo-sort.js' | asset_url }}"></script>

<style>
  .photo-sort { margin: 1rem 0 0; }
  .photo-sort__hint { font-size: var(--fs-xs); color: var(--muted); margin: 0 0 .5rem; }
  .photo-sort__list { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; padding: 0; margin: 0; }
  .photo-sort__item { position: relative; width: 92px; height: 92px; border-radius: var(--r-sm); overflow: hidden; cursor: grab; background: var(--surface-2); border: 1px solid var(--line); }
  .photo-sort__item img { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .photo-sort__item.is-dragging { opacity: .45; cursor: grabbing; }
  .photo-sort__item:only-child { cursor: default; }
  .photo-sort__item:only-child .photo-sort__nav { display: none; }
  .photo-sort__cover { position: absolute; top: 4px; left: 4px; font-size: 10px; font-weight: 700; color: var(--charcoal); background: var(--accent); padding: .1rem .35rem; border-radius: var(--r-pill); }
  .photo-sort__del { position: absolute; top: 4px; right: 4px; width: 22px; height: 22px; padding: 0; border: 0; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 15px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .12s ease; }
  .photo-sort__del:hover { background: rgba(0,0,0,.75); }
  .photo-sort__item:hover .photo-sort__del, .photo-sort__del:focus-visible { opacity: 1; }
  .photo-sort__nav { position: absolute; top: 50%; transform: translateY(-50%); width: 22px; height: 30px; border: 0; background: rgba(0,0,0,.45); color: #fff; font-size: 15px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity .12s ease; }
  .photo-sort__item:hover .photo-sort__nav, .photo-sort__nav:focus-visible { opacity: 1; }
  .photo-sort__nav--prev { left: 0; border-radius: 0 4px 4px 0; }
  .photo-sort__nav--next { right: 0; border-radius: 4px 0 0 4px; }
  .photo-sort__status { display: inline-block; margin-top: .5rem; font-size: var(--fs-xs); color: var(--muted); }
  @media (hover: none) { .photo-sort__nav, .photo-sort__del { opacity: 1; } }
</style>
{%- endif -%}
