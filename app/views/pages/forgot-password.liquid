---
metadata:
  title: Reset your password
---
<section class="container" style="max-width:46ch;padding:3rem 0;">
  <h1>Forgot your password?</h1>

  {%- if context.params.sent -%}
    <div class="flash flash--notice">If that address has an account, we've emailed a link to reset your password. Check your inbox.</div>
    <p style="margin-top:1.5rem;" class="muted">Didn't get it? Check your spam folder, or request another link below.</p>
  {%- else -%}
    <p class="muted">Enter the email address on your account and we'll send you a link to set a new password.</p>
  {%- endif -%}

  <form action="/password/reset" method="post" class="stack">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <div class="field">
      <label for="fp-email">Email</label>
      <input class="input" id="fp-email" type="email" name="email" required autocomplete="email">
    </div>
    <button class="btn btn--primary" type="submit">Send reset link</button>
  </form>
</section>
