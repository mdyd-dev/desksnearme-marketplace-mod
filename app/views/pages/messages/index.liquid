---
metadata:
  title: Messages
authorization_policies: [require_login]
---
{%- liquid
  assign uid = context.current_user.id
  assign view_archived = false
  if context.params.view == 'archived'
    assign view_archived = true
  endif

  graphql c = 'conversations/get_for_user', user_id: uid
  assign raw_guest = c.as_guest.results
  assign raw_host = c.as_host.results

  assign shown_ids = ''
  assign show_guest = 0
  assign show_host = 0
  assign show_support = 0
  assign arch_count = 0

  for cv in raw_guest
    assign is_arch = false
    if cv.guest_archived_at != blank
      assign is_arch = true
      assign arch_count = arch_count | plus: 1
    endif
    if is_arch == view_archived
      assign shown_ids = shown_ids | append: '|' | append: cv.id | append: '|'
      if cv.type == 'support'
        assign show_support = show_support | plus: 1
      else
        assign show_guest = show_guest | plus: 1
      endif
    endif
  endfor

  for cv in raw_host
    assign is_arch = false
    if cv.host_archived_at != blank
      assign is_arch = true
      assign arch_count = arch_count | plus: 1
    endif
    if is_arch == view_archived
      assign shown_ids = shown_ids | append: '|' | append: cv.id | append: '|'
      if cv.type == 'support'
        assign show_support = show_support | plus: 1
      else
        assign show_host = show_host | plus: 1
      endif
    endif
  endfor

  assign total_shown = show_guest | plus: show_host | plus: show_support

  assign all_convos = raw_guest | concat: raw_host
  assign convo_ids = all_convos | map: 'id'

  assign msgs = nil
  if convo_ids != blank
    graphql lm = 'messages/last_for_conversations', conversation_ids: convo_ids
    assign msgs = lm.records.results
  endif

  # threads with at least one unread message, within the view being shown
  assign unread_total = 0
  assign counted_ids = ''
  for m in msgs
    if m.recipient_id == uid and m.read == false
      assign marker = '|' | append: m.conversation_id | append: '|'
      if shown_ids contains marker
        unless counted_ids contains marker
          assign counted_ids = counted_ids | append: marker
          assign unread_total = unread_total | plus: 1
        endunless
      endif
    endif
  endfor
-%}
<div class="page-narrow">
  <div class="page-head">
    <div class="page-head__text">
      <h1>{% if view_archived %}Archived{% else %}Messages{% endif %}</h1>
      {%- if total_shown > 0 -%}
        <p class="page-head__meta">{{ total_shown }} {% if total_shown == 1 %}conversation{% else %}conversations{% endif %}{% if unread_total > 0 %} &middot; {{ unread_total }} unread{% endif %}</p>
      {%- endif -%}
    </div>
    {%- if view_archived -%}
      <a class="page-head__action btn btn--link" href="/messages">Inbox<span aria-hidden="true"> →</span></a>
    {%- elsif arch_count > 0 -%}
      <a class="page-head__action btn btn--link" href="/messages?view=archived">Archived ({{ arch_count }})<span aria-hidden="true"> →</span></a>
    {%- endif -%}
  </div>

  {%- if context.params.archived_one -%}<div class="flash flash--notice">Conversation archived.</div>{%- endif -%}
  {%- if context.params.restored -%}<div class="flash flash--notice">Conversation moved back to your inbox.</div>{%- endif -%}

  {%- if total_shown == 0 -%}
    <div class="msg-empty">
      {%- if view_archived -%}
        <p class="muted">Nothing archived.</p>
      {%- else -%}
        <p class="muted">You don’t have any messages yet.</p>
        <p class="muted">Find a space you like and hit <strong>Inquire</strong> to start a conversation with the host.</p>
        <a class="btn btn--primary" href="/listings">Browse spaces</a>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- if show_support > 0 -%}
      <h2 class="section-label">Support</h2>
      <ul class="msg-list">
        {%- comment -%} support account's view: requests from users {%- endcomment -%}
        {%- for convo in raw_host -%}
          {%- if convo.type == 'support' -%}
            {%- assign is_arch = false -%}
            {%- if convo.host_archived_at != blank -%}{%- assign is_arch = true -%}{%- endif -%}
            {%- if is_arch == view_archived -%}
              {% include 'messages/row', convo: convo, who: convo.guest_name, who_avatar: convo.guest_avatar.first.photo.versions.sm, who_prefix: 'from', msgs: msgs, uid: uid, is_archived: is_arch, variant: 'brand' %}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- comment -%} user's view: their thread with Support {%- endcomment -%}
        {%- for convo in raw_guest -%}
          {%- if convo.type == 'support' -%}
            {%- assign is_arch = false -%}
            {%- if convo.guest_archived_at != blank -%}{%- assign is_arch = true -%}{%- endif -%}
            {%- if is_arch == view_archived -%}
              {% include 'messages/row', convo: convo, who: 'Support', who_avatar: convo.host_avatar.first.photo.versions.sm, who_prefix: '', msgs: msgs, uid: uid, is_archived: is_arch, variant: 'brand' %}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if show_host > 0 -%}
      <h2 class="section-label">Inquiries about your spaces</h2>
      <ul class="msg-list">
        {%- for convo in raw_host -%}
          {%- unless convo.type == 'support' -%}
            {%- assign is_arch = false -%}
            {%- if convo.host_archived_at != blank -%}{%- assign is_arch = true -%}{%- endif -%}
            {%- if is_arch == view_archived -%}
              {% include 'messages/row', convo: convo, who: convo.guest_name, who_avatar: convo.guest_avatar.first.photo.versions.sm, who_prefix: 'from', msgs: msgs, uid: uid, is_archived: is_arch %}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if show_guest > 0 -%}
      <h2 class="section-label">Spaces you’ve inquired about</h2>
      <ul class="msg-list">
        {%- for convo in raw_guest -%}
          {%- unless convo.type == 'support' -%}
            {%- assign is_arch = false -%}
            {%- if convo.guest_archived_at != blank -%}{%- assign is_arch = true -%}{%- endif -%}
            {%- if is_arch == view_archived -%}
              {% include 'messages/row', convo: convo, who: convo.host_name, who_avatar: convo.host_avatar.first.photo.versions.sm, who_prefix: 'with', msgs: msgs, uid: uid, is_archived: is_arch %}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- endif -%}
</div>
<style>
  .page-narrow { max-width: 680px; }
  .msg-empty { text-align: center; padding: 2.5rem 1rem; border: 1px dashed var(--line); }
  .msg-empty .btn { margin-top: 1rem; }
  .msg-list { list-style: none; margin: 0 0 .5rem; padding: 0; }

  .msg-item { position: relative; margin-bottom: .6rem; }
  .msg-item__act { position: absolute; top: .5rem; right: .5rem; opacity: 0; transition: opacity .12s ease; }
  .msg-item:hover .msg-item__act, .msg-item__act:focus-within { opacity: 1; }
  .msg-item__act button { border: 0; background: var(--surface-2); color: var(--muted); border-radius: 50%; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .msg-item__act button:hover { background: var(--line); color: var(--ink); }
  .msg-item__act svg { width: 15px; height: 15px; }

  .msg-row { display: flex; align-items: center; gap: .85rem; padding: .9rem 1.1rem; border: 1px solid var(--line); box-shadow: var(--shadow-1); background: #fff; transition: box-shadow .15s ease, transform .15s ease; }
  .msg-row:hover { box-shadow: var(--shadow-2); transform: translateY(-1px); text-decoration: none; }
  .msg-row__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .1rem; }
  .msg-row__top { display: flex; align-items: baseline; gap: .5rem; flex-wrap: wrap; }
  .msg-row__title { font-weight: 700; color: var(--ink); }
  .msg-row__who { font-size: var(--fs-sm); color: var(--muted); }
  .msg-row__preview { font-size: var(--fs-sm); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: .15rem; }
  .msg-row--unread .msg-row__preview { color: var(--ink); font-weight: 700; }
  .msg-row__meta { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: .35rem; padding-right: 1.9rem; }
  .msg-row__time { font-size: 11px; color: var(--muted); white-space: nowrap; }
</style>