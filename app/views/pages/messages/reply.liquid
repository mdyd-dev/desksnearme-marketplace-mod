---
slug: messages/:id/reply
method: post
authorization_policies: [require_login]
---
{%- liquid
  assign cid = context.params.id
  assign uid = context.current_user.id
  assign body = context.params.body | strip

  graphql cg = 'conversations/get', id: cid
  assign convo = cg.records.results.first

  assign is_member = false
  assign recipient_id = ''
  assign my_side = ''
  if convo
    if convo.guest_id == uid
      assign is_member = true
      assign recipient_id = convo.host_id
      assign my_side = 'guest'
    elsif convo.host_id == uid
      assign is_member = true
      assign recipient_id = convo.guest_id
      assign my_side = 'host'
    endif
  endif

  unless is_member
    redirect_to '/messages'
    break
  endunless

  assign thread_url = '/messages/' | append: cid

  if body == blank
    redirect_to thread_url
    break
  endif

  assign fn = context.current_user.first_name | default: ''
  assign ln = context.current_user.last_name | default: ''
  assign sender_name = fn | append: ' ' | append: ln | strip
  if sender_name == blank
    assign sender_name = context.current_user.name | default: context.current_user.email
  endif

  graphql pending = 'messages/unread_in_conversation', user_id: recipient_id, conversation_id: cid
  assign already_unread = pending.records.results | size

  graphql m = 'messages/create', conversation_id: cid, sender_id: uid, sender_name: sender_name, recipient_id: recipient_id, body: body

  assign now = 'now' | date: '%s'
  assign now_i = now | plus: 0
  graphql t = 'conversations/touch', id: cid, last_message_at: now

  # a new message reactivates the thread for both people — it returns to the
  # recipient's inbox, and also to the sender's own inbox if they'd archived it
  graphql ua = 'conversations/archive', id: cid, host_archived_at: '', guest_archived_at: ''

  assign cooldown = 1800
  assign last_notified = 0
  if my_side == 'guest'
    assign last_notified = convo.host_notified_at | default: 0 | plus: 0
  else
    assign last_notified = convo.guest_notified_at | default: 0 | plus: 0
  endif
  assign since = now_i | minus: last_notified

  assign to_email = ''
  assign should_notify = false
  if already_unread == 0 and since > cooldown
    graphql ru = 'users/get_user', id: recipient_id
    assign to_email = ru.user.email
    if to_email != blank
      assign should_notify = true
    endif
  endif

  assign preview = body | truncate: 600
  assign listing_title = convo.listing_title | default: 'a space'
  assign abs_url = context.location.host | prepend: 'https://' | append: thread_url
-%}
{%- if should_notify -%}
  {%- parse_json mail_data -%}
  {
    "to_email": {{ to_email | json }},
    "sender_name": {{ sender_name | json }},
    "listing_title": {{ listing_title | json }},
    "body": {{ preview | json }},
    "thread_url": {{ abs_url | json }}
  }
  {%- endparse_json -%}
  {%- liquid
    graphql em = 'emails/send_new_message', data: mail_data
    assign h_notified = convo.host_notified_at
    assign g_notified = convo.guest_notified_at
    if my_side == 'guest'
      assign h_notified = now
    else
      assign g_notified = now
    endif
    graphql mn = 'conversations/mark_notified', id: cid, host_notified_at: h_notified, guest_notified_at: g_notified
  -%}
{%- endif -%}
{%- liquid
  redirect_to thread_url
-%}