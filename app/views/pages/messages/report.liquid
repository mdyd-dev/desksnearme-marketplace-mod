---
slug: messages/:id/report
method: post
authorization_policies: [require_login]
---
{%- liquid
  assign cid = context.params.id
  assign uid = context.current_user.id
  assign reason = context.params.reason | strip | truncate: 2000

  graphql cg = 'conversations/get', id: cid
  assign convo = cg.records.results.first

  assign my_side = ''
  assign other_name = ''
  if convo
    if convo.guest_id == uid
      assign my_side = 'guest'
      assign other_name = convo.host_name
    elsif convo.host_id == uid
      assign my_side = 'host'
      assign other_name = convo.guest_name
    endif
  endif

  if my_side == blank
    redirect_to '/messages'
    break
  endif

  assign thread_url = '/messages/' | append: cid

  if reason == blank
    redirect_to thread_url
    break
  endif

  assign fn = context.current_user.first_name | default: ''
  assign ln = context.current_user.last_name | default: ''
  assign reporter_name = fn | append: ' ' | append: ln | strip
  if reporter_name == blank
    assign reporter_name = context.current_user.email
  endif
  assign reporter_email = context.current_user.email
  assign listing_title = convo.listing_title | default: 'a space'
-%}
{%- parse_json report_data -%}
{
  "conversation_id": {{ cid | json }},
  "reporter_name": {{ reporter_name | json }},
  "reporter_email": {{ reporter_email | json }},
  "listing_title": {{ listing_title | json }},
  "other_name": {{ other_name | default: 'unknown' | json }},
  "reason": {{ reason | json }}
}
{%- endparse_json -%}
{%- liquid
  graphql em = 'emails/send_message_report', data: report_data
  assign done_url = thread_url | append: '?reported=1'
  redirect_to done_url
-%}