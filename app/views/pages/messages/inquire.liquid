---
method: post
authorization_policies: [require_login]
---
{%- liquid
  assign listing_id = context.params.listing_id
  assign guest_id = context.current_user.id
  graphql g = 'listings/get', id: listing_id
  assign listing = g.records.results.first
  if listing == blank
    redirect_to '/listings'
  else
    assign host_id = listing.host_id
    if host_id == guest_id
      assign own_url = '/listings/' | append: listing_id
      redirect_to own_url
    else
      graphql existing = 'conversations/find', guest_id: guest_id, host_id: host_id, listing_id: listing_id
      assign convo = existing.records.results.first
      if convo
        assign convo_url = '/messages/' | append: convo.id
        redirect_to convo_url
      else
        graphql hp = 'profiles/get_by_user', user_id: host_id
        assign host_profile = hp.records.results.first
        assign host_name = host_profile.company_name | default: listing.host.first_name | default: listing.host.name | default: 'Host'
        assign guest_name = context.current_user.name | default: context.current_user.first_name | default: 'Guest'
        assign now = 'now' | date: '%s'
        graphql c = 'conversations/create', guest_id: guest_id, host_id: host_id, listing_id: listing_id, listing_title: listing.title, host_name: host_name, guest_name: guest_name, last_message_at: now
        assign new_url = '/messages/' | append: c.record_create.id
        redirect_to new_url
      endif
    endif
  endif
-%}