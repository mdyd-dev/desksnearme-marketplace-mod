---
metadata:
  title: Contact us
  description: Get help with your Desks Near Me account or a listing. Start a support chat, check the FAQ, or send us a message.
---
<div class="page-narrow">
  <p class="page-eyebrow">Contact us</p>
  <h1>How can we help?</h1>
  <p class="page-lead">Most questions are answered in the <a href="/faq">FAQ</a>. If you’re still stuck, send us a message and we’ll get back to you by email.</p>

  {%- if context.params.sent -%}
    <div class="flash flash--notice">Thanks — your message is on its way. We’ll reply to the email address you gave us.</div>
  {%- elsif context.params.contact_error == 'captcha' -%}
    <div class="flash flash--alert">Please complete the “I’m not a robot” check and send again.</div>
  {%- elsif context.params.contact_error -%}
    <div class="flash flash--alert">Please add your email and a message, then send again.</div>
  {%- endif -%}

  {%- if context.params.chat_unavailable -%}
    <div class="flash flash--alert">Live chat isn’t available right now — please send us a message below and we’ll reply by email.</div>
  {%- endif -%}

  {%- liquid
    assign is_support_user = false
    if context.current_user and context.current_user.email == 'support@desksnear.me'
      assign is_support_user = true
    endif
  -%}
  {%- if context.current_user and is_support_user == false -%}
    <div class="support-chat-cta">
      <h2>Chat with us</h2>
      <p class="muted">Start a support conversation and we’ll reply right in your <a href="/messages">messages</a> — no email back-and-forth.</p>
      <form action="/support/chat" method="post">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <button class="btn btn--primary" type="submit">Start a support chat</button>
      </form>
    </div>
    <p class="support-or muted">Or send us a message and we’ll reply by email:</p>
  {%- endif -%}

  <form action="/support/contact" method="post" class="contact-form stack">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">

    <div class="field">
      <label for="cf-name">Name</label>
      <input class="input" id="cf-name" name="name" type="text" autocomplete="name" value="{{ context.params.name }}">
    </div>

    <div class="field">
      <label for="cf-email">Email</label>
      <input class="input" id="cf-email" name="email" type="email" required autocomplete="email" value="{{ context.params.email }}">
      <span class="field__hint">So we can reply to you.</span>
    </div>

    <div class="field">
      <label for="cf-subject">Subject</label>
      <input class="input" id="cf-subject" name="subject" type="text" value="{{ context.params.subject }}">
    </div>

    <div class="field">
      <label for="cf-message">Message</label>
      <textarea class="textarea" id="cf-message" name="message" rows="6" required>{{ context.params.message }}</textarea>
    </div>

    <div class="cf-hp" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off">
    </div>

    <div class="g-recaptcha" data-sitekey="{{ context.constants.recaptcha_site_key }}"></div>

    <button class="btn btn--primary" type="submit">Send message</button>
  </form>

  <p class="muted contact-alt">Prefer email? Write to us at <a href="mailto:support@desksnear.me">support@desksnear.me</a>.</p>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<style>
  .page-narrow { max-width: 640px; }
  .page-eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: var(--fs-xs); font-weight: 600; color: var(--accent-ink); margin: 0 0 .75rem; }
  .page-lead { font-size: var(--fs-md); color: var(--muted); margin: 0 0 2rem; max-width: 60ch; }
  .support-chat-cta { border: 1px solid var(--line); border-radius: var(--r); background: var(--surface-2); padding: 1.25rem 1.4rem; margin: 0 0 1.5rem; }
  .support-chat-cta h2 { margin: 0 0 .35rem; font-size: var(--fs-lg); }
  .support-chat-cta p { margin: 0 0 1rem; font-size: var(--fs-sm); }
  .support-or { font-size: var(--fs-sm); margin: 0 0 1rem; }
  .contact-form { margin: 0 0 1.5rem; }
  .contact-form .g-recaptcha { margin: .25rem 0; }
  .contact-alt { font-size: var(--fs-sm); }
  .cf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>