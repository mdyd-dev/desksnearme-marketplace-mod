---
method: post
---
{%- liquid
  assign base_url = 'https://desksnear.me'
  assign email = context.params.email | strip | downcase
-%}
{%- if email contains '@' -%}
  {%- liquid
    graphql u = 'users/find_by_email', email: email
    assign user = u.users.results.first
  -%}
  {%- if user -%}
    {%- liquid
      graphql p = 'profiles/get_by_user', user_id: user.id
      assign prof = p.records.results.first
    -%}
    {%- if prof and prof.confirmed_at == blank -%}
      {%- liquid
        assign now_epoch = 'now' | date: '%s' | plus: 0
        assign last_epoch = prof.confirmation_sent_at | plus: 0
        assign since = now_epoch | minus: last_epoch
      -%}
      {%- if since >= 60 -%}
        {%- liquid
          graphql tok = 'users/get_temporary_token', email: email
          assign token = tok.users.results.first.temporary_token
          assign sent_at = 'now' | date: '%s'
          graphql sc = 'profiles/set_confirmation', id: prof.id, confirmation_token: token, confirmation_sent_at: sent_at
          assign confirm_url = base_url | append: '/confirm?token=' | append: token
        -%}
        {%- parse_json data -%}
        { "email": {{ email | json }}, "first_name": "", "confirm_url": {{ confirm_url | json }} }
        {%- endparse_json -%}
        {%- liquid graphql send = 'emails/send_confirmation', data: data -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{%- liquid redirect_to '/check-email?resent=1' -%}