---
method: post
---
{%- liquid
  assign base_url = 'https://desksnear.me'

  assign email = context.params.email | strip | downcase
  assign role = context.params.role
  unless role == 'guest' or role == 'host'
    assign role = 'guest'
  endunless

  assign honeypot = context.params.website | strip

  # Cheap heuristics first, then the captcha (an outbound HTTP call), then the DB work.
  assign too_fast = false
  assign submitted_at = context.params.ts | plus: 0
  assign now_epoch = 'now' | date: '%s' | plus: 0
  if submitted_at == 0
    assign too_fast = true
  else
    assign fill_time = now_epoch | minus: submitted_at
    if fill_time < 2
      assign too_fast = true
    endif
  endif

  assign valid = true
  unless email contains '@'
    assign valid = false
  endunless
  if context.params.password == blank
    assign valid = false
  endif

  assign disposable = false
  if valid
    assign domain = email | split: '@' | last
    capture blocklist
      render 'auth/disposable_domains'
    endcapture
    assign blocked = blocklist | split: ','
    for entry in blocked
      assign candidate = entry | strip
      if candidate == domain
        assign disposable = true
        break
      endif
    endfor
  endif
-%}
{%- if honeypot != blank -%}
  {%- comment -%} Bot filled the hidden field — act as if it worked, create nothing. {%- endcomment -%}
  {%- liquid redirect_to '/check-email' -%}
{%- elsif too_fast -%}
  {%- liquid redirect_to '/?signup_error=1' -%}
{%- elsif valid == false -%}
  {%- liquid redirect_to '/?signup_error=1' -%}
{%- elsif disposable -%}
  {%- liquid redirect_to '/?signup_error=email' -%}
{%- else -%}
  {%- parse_json rc_data -%}
  { "secret": {{ context.constants.recaptcha_secret_key | json }}, "token": {{ context.params['g-recaptcha-response'] | json }} }
  {%- endparse_json -%}
  {%- liquid
    graphql rc = 'api_calls/recaptcha_verify', data: rc_data
    assign rc_body = rc.api_call_send.response.body | parse_json
  -%}
  {%- if rc_body.success != true -%}
    {%- liquid redirect_to '/?signup_error=captcha' -%}
  {%- else -%}
    {%- liquid
      graphql existing = 'users/find_by_email', email: email
    -%}
    {%- if existing.users.results.first -%}
      {%- liquid redirect_to '/?signup_error=exists' -%}
    {%- else -%}
      {%- liquid
        graphql result = 'users/create', email: email, password: context.params.password, first_name: context.params.first_name, last_name: context.params.last_name
      -%}
      {%- if result.user_create.id -%}
        {%- liquid
          graphql tok = 'users/get_temporary_token', email: email
          assign token = tok.users.results.first.temporary_token
          assign sent_at = 'now' | date: '%s'
          graphql pc = 'profiles/create', user_id: result.user_create.id, role: role, confirmation_token: token, confirmation_sent_at: sent_at
          assign confirm_url = base_url | append: '/confirm?token=' | append: token
        -%}
        {%- parse_json data -%}
        {
          "email": {{ email | json }},
          "first_name": {{ context.params.first_name | default: '' | json }},
          "confirm_url": {{ confirm_url | json }}
        }
        {%- endparse_json -%}
        {%- liquid
          graphql send = 'emails/send_confirmation', data: data
          redirect_to '/check-email'
        -%}
      {%- else -%}
        {%- liquid
          graphql recheck = 'users/find_by_email', email: email
          if recheck.users.results.first
            redirect_to '/?signup_error=exists'
          else
            redirect_to '/?signup_error=1'
          endif
        -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
