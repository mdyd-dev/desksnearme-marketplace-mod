---
metadata:
  title: Admin
authorization_policies: [require_admin]
---
{%- liquid
  graphql u = 'users/get_users', per_page: 1, page: 1
  graphql l = 'listings/get_all', per_page: 1, page: 1
-%}
<h1>Admin</h1>
<div class="admin-cards">
  <a class="admin-card" href="/admin/users">
    <span class="admin-card__num">{{ u.users.total_entries }}</span>
    <span class="admin-card__label">Users</span>
    <span class="admin-card__cta">Manage users →</span>
  </a>
  <a class="admin-card" href="/admin/listings">
    <span class="admin-card__num">{{ l.records.total_entries }}</span>
    <span class="admin-card__label">Listings</span>
    <span class="admin-card__cta">Manage listings →</span>
  </a>
</div>
<style>
  .admin-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1.25rem; margin-top:1.5rem; }
  .admin-card { display:flex; flex-direction:column; gap:.25rem; padding:1.5rem; border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow-1); background:#fff; }
  .admin-card:hover { box-shadow:var(--shadow-2); text-decoration:none; transform:translateY(-2px); transition:.15s; }
  .admin-card__num { font-family:var(--font-display); font-size:var(--fs-2xl); font-weight:700; color:var(--ink); }
  .admin-card__label { font-size:var(--fs-sm); color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .admin-card__cta { margin-top:.5rem; color:var(--accent-ink); font-weight:600; font-size:var(--fs-sm); }
</style>