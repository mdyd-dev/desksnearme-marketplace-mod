---
method: post
authorization_policies: [require_admin]
---
{%- liquid
  assign id = context.params.id
  assign want = context.params.featured

  assign back = '/admin/listings?'
  unless context.params.q == blank
    assign q_enc = context.params.q | url_encode
    assign back = back | append: 'q=' | append: q_enc | append: '&'
  endunless
  unless context.params.page == blank
    assign back = back | append: 'page=' | append: context.params.page | append: '&'
  endunless

  if id == blank
    redirect_to '/admin/listings'
  else
    if want == 'true'
      assign now = 'now' | date: '%Y-%m-%dT%H:%M:%S'
      graphql r = 'admin/set_featured', id: id, featured: 'true', featured_at: now
      assign back = back | append: 'done=featured'
    else
      graphql r = 'admin/set_featured', id: id, featured: 'false', featured_at: ''
      assign back = back | append: 'done=unfeatured'
    endif
    redirect_to back
  endif
-%}