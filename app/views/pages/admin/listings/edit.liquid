---
slug: admin/listings/:id/edit
metadata:
  title: Edit listing
authorization_policies: [require_admin]
---
{%- liquid
  graphql g = 'listings/get', id: context.params.id
  assign listing = g.records.results.first

  assign form_uuid = listing.uuid
  if form_uuid == blank
    assign form_uuid = '' | uuid
  endif

  assign missing = context.params.missing | default: '' | split: ','
-%}

{% if listing == blank %}
  <div class="listings-empty">
    <h1>Listing not found</h1>
    <p class="muted">No listing with that id. <a href="/admin/listings">Back to manage listings</a>.</p>
  </div>
{% else %}
  <a class="listing-detail__back" href="/admin/listings">← Manage listings</a>

  <div class="lf-head">
    <h1>{{ listing.title | default: 'Untitled listing' }}</h1>
    <span class="status-pill status-pill--{{ listing.status | default: 'draft' }}">{{ listing.status | default: 'draft' }}</span>
  </div>

  <div class="flash flash--alert">
    <strong>Editing as admin.</strong> This listing belongs to {{ listing.host_name | default: 'a host' }}. Changes save as theirs.
  </div>

  {% if context.params.error == 'publish' %}
    <div class="flash flash--alert">
      <strong>Not published yet.</strong> Changes are saved, but these are still needed:
      <ul class="flash__list">
        {% for m in missing %}
          {%- case m -%}
            {%- when 'title' -%}<li>A title</li>
            {%- when 'type' -%}<li>A space type</li>
            {%- when 'capacity' -%}<li>How many people it fits</li>
            {%- when 'price' -%}<li>At least one rate</li>
          {%- endcase -%}
        {% endfor %}
      </ul>
    </div>
  {% elsif context.params.saved %}
    <div class="flash flash--notice">Saved.</div>
  {% endif %}

  {% include 'listings/form', listing: listing, form_uuid: form_uuid, form_action: '/account/listings/update', cancel_url: '/admin/listings' %}
{% endif %}

<style>
  .lf-head { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .lf-head h1 { margin: 0; }
  .flash__list { margin: .4rem 0 0; padding-left: 1.1rem; font-size: var(--fs-sm); }
  .status-pill { display: inline-block; font-size: var(--fs-xs); font-weight: 600; padding: .15rem .55rem; border-radius: var(--r-pill); text-transform: capitalize; }
  .status-pill--published { background: color-mix(in srgb, var(--success) 15%, #fff); color: var(--success); }
  .status-pill--draft { background: var(--surface-2); color: var(--muted); }
</style>