---
method: post
authorization_policies: [require_admin]
---
{%- liquid
  assign id = context.params.id
  assign want = context.params.hero

  assign back = '/admin/listings?'
  unless context.params.q == blank
    assign q_enc = context.params.q | url_encode
    assign back = back | append: 'q=' | append: q_enc | append: '&'
  endunless
  unless context.params.page == blank
    assign back = back | append: 'page=' | append: context.params.page | append: '&'
  endunless

  if id == blank
    redirect_to '/admin/listings'
  else
    if want == 'true'
      graphql cur = 'listings/hero'
      for h in cur.records.results
        unless h.id == id
          graphql clr = 'admin/set_hero', id: h.id, hero: 'false'
        endunless
      endfor
      graphql r = 'admin/set_hero', id: id, hero: 'true'
      assign back = back | append: 'done=hero'
    else
      graphql r = 'admin/set_hero', id: id, hero: 'false'
      assign back = back | append: 'done=unhero'
    endif
    redirect_to back
  endif
-%}
