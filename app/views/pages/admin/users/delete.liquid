---
method: post
authorization_policies: [require_admin]
---
{%- liquid
  assign target_id = context.params.id | append: ''
  assign current_id = context.current_user.id | append: ''

  assign back_page = context.params.page | default: 1
  assign back_q = context.params.q | strip
  assign back = '/admin/users?page=' | append: back_page
  unless back_q == blank
    assign back_q_enc = back_q | url_encode
    assign back = back | append: '&q=' | append: back_q_enc
  endunless

  if target_id == blank
    redirect_to back
  elsif target_id == current_id
    assign dest = back | append: '&error=self_delete'
    redirect_to dest
  else
    # 0. collect conversations first — needs the user's id before deletion
    graphql uc = 'conversations/get_for_user', user_id: target_id
    assign convos = uc.as_guest.results | concat: uc.as_host.results

    # 1. delete the user account first (so a later failure can't strand it)
    graphql du = 'admin/delete_user', id: target_id
    assign user_ok = du.user_delete.id

    if user_ok == blank
      echo 'user_delete failed: '
      echo du.errors
    else
      # 2. delete the user's profile record
      graphql pr = 'profiles/get_by_user', user_id: target_id
      assign profile = pr.records.results.first
      if profile
        graphql dp = 'admin/delete_record', table: 'profile', id: profile.id
      endif

      # 3. delete each conversation's messages, then the conversation
      for cv in convos
        graphql cm = 'messages/get_for_conversation', conversation_id: cv.id
        for msg in cm.records.results
          graphql dm = 'admin/delete_record', table: 'message', id: msg.id
        endfor
        graphql dc = 'admin/delete_record', table: 'conversation', id: cv.id
      endfor

      # 4. delete each listing's photos, then the listing
      graphql ul = 'admin/get_user_listings', host_id: target_id
      for listing in ul.records.results
        if listing.uuid != blank
          graphql gph = 'photos/search', object_uuid: listing.uuid, photo_type: 'listing'
          for p in gph.photos.results
            graphql dph = 'photos/delete', id: p.id
          endfor
        endif
        graphql dl = 'admin/delete_record', table: 'listing', id: listing.id
      endfor

      assign dest = back | append: '&deleted=1'
      redirect_to dest
    endif
  endif
-%}