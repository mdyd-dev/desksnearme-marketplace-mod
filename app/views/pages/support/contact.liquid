---
method: post
---
{%- liquid
  assign name = context.params.name | strip
  assign email = context.params.email | strip | downcase
  assign subject = context.params.subject | strip
  assign message = context.params.message | strip
  assign honeypot = context.params.website | strip
  assign token = context.params['g-recaptcha-response']
-%}
{%- if honeypot != blank -%}
  {%- comment -%} Bot filled the hidden field — silently accept and drop. {%- endcomment -%}
  {%- liquid redirect_to '/support?sent=1' -%}
{%- else -%}
  {%- liquid
    assign valid = true
    unless email contains '@'
      assign valid = false
    endunless
    if message == blank
      assign valid = false
    endif
  -%}
  {%- if valid == false -%}
    {%- liquid redirect_to '/support?contact_error=1' -%}
  {%- else -%}
    {%- parse_json rc_data -%}
    { "secret": {{ context.constants.recaptcha_secret_key | json }}, "token": {{ token | json }} }
    {%- endparse_json -%}
    {%- liquid
      graphql rc = 'api_calls/recaptcha_verify', data: rc_data
      assign rc_body = rc.api_call_send.response.body | parse_json
    -%}
    {%- if rc_body.success -%}
      {%- parse_json data -%}
      {
        "name": {{ name | default: '(not given)' | json }},
        "email": {{ email | json }},
        "subject": {{ subject | default: '(no subject)' | json }},
        "message": {{ message | json }}
      }
      {%- endparse_json -%}
      {%- liquid
        graphql send = 'emails/send_support_contact', data: data
        redirect_to '/support?sent=1'
      -%}
    {%- else -%}
      {%- liquid redirect_to '/support?contact_error=captcha' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}