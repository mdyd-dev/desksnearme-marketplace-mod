---
metadata:
  title: My account
authorization_policies: [require_login]
---
{%- liquid
  assign u = context.current_user
  graphql p = 'profiles/get_by_user', user_id: u.id
  assign profile = p.records.results.first
  assign role = profile.role | default: 'guest'

  graphql pp = 'photos/search', object_uuid: u.id, photo_type: 'profile', limit: 1
  assign avatar_photo = pp.photos.results.first
  assign avatar_url = avatar_photo.photo.versions.m | default: ''

  assign no_photos = '' | split: ','
  graphql presign = 'photos/presign'
-%}
<div class="account-wrap">
  <div class="account-head">
    <div>
      <h1>My account</h1>
      <p class="muted">Account type: <strong style="text-transform:capitalize;">{{ role }}</strong></p>
    </div>
    <div class="account-head__actions">
      <a class="btn btn--ghost" href="/users/{{ u.id }}">View my profile</a>
      {% if role == 'host' %}
        <a class="btn btn--ghost" href="/account/listings">My listings</a>
      {% endif %}
      {% if role == 'guest' or role == 'host' %}
        <a class="btn btn--ghost" href="/account/favorites">Saved spaces</a>
      {% endif %}
    </div>
  </div>

  {% if context.params.saved %}
    <div class="flash flash--notice">Your profile has been updated.</div>
  {% endif %}

  <section class="avatar-edit" id="sec-photo">
    <div class="avatar-edit__head">
      <h2 class="avatar-edit__title">Profile picture</h2>
      <p class="avatar-edit__hint">Add a square image (PNG, JPG, or WebP). Crop it, click Save, then Upload — your new picture replaces the current one.</p>
    </div>
    {% if avatar_photo %}
      <div class="avatar-edit__current">
        <img class="avatar-edit__thumb" src="{{ avatar_url }}" alt="Your current profile picture" width="56" height="56">
        <span class="avatar-edit__currentlabel">Current picture</span>
        <form action="/account/photo/delete" method="post" onsubmit="return confirm('Remove your profile picture?');">
          <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
          <button class="btn btn--ghost" type="submit">Remove</button>
        </form>
      </div>
    {% endif %}
    {% render 'photos/s3_form',
       presigned_url: presign.presigned,
       object_uuid: u.id,
       photo_type: 'profile',
       max_number_of_files: 1,
       editor_enabled: true,
       existing_photos: no_photos,
       note: 'PNG / JPG / WEBP · 1 square image' %}
  </section>

  <script>
    document.addEventListener('listing-photos-added', function () { window.location.reload(); });
  </script>

  <form action="/account/update" method="post" class="account-form">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">

    <div class="account-form__row">
      <div class="field">
        <label for="ac-first">First name</label>
        <input class="input" id="ac-first" name="first_name" type="text" value="{{ u.first_name }}">
      </div>
      <div class="field">
        <label for="ac-last">Last name</label>
        <input class="input" id="ac-last" name="last_name" type="text" value="{{ u.last_name }}">
      </div>
    </div>

    <div class="field">
      <label for="ac-email">Email</label>
      <input class="input" id="ac-email" type="email" value="{{ u.email }}" disabled>
      <span class="field__hint">Email can’t be changed here yet.</span>
    </div>

    <div class="field">
      <label for="ac-phone">Phone</label>
      <input class="input" id="ac-phone" name="phone" type="tel" value="{{ profile.phone }}">
    </div>

    {% if role == 'host' or role == 'admin' %}
      <div class="field">
        <label for="ac-company">Company / business name</label>
        <input class="input" id="ac-company" name="company_name" type="text" value="{{ profile.company_name }}">
      </div>
    {% endif %}

    <div class="field">
      <label for="ac-bio">Bio</label>
      <textarea class="textarea" id="ac-bio" name="bio">{{ profile.bio }}</textarea>
      <span class="field__hint">Shown on your public profile.</span>
    </div>

    <div class="account-form__actions">
      <button class="btn btn--primary" type="submit">Save changes</button>
    </div>
  </form>
</div>

<style>
  .account-wrap { max-width: 680px; }
  .account-head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem; }
  .account-head h1 { margin:0 0 .25rem; }
  .account-head p { margin:0; }
  .account-head__actions { display:flex; gap:.5rem; flex-wrap:wrap; }

  .avatar-edit { margin:0 0 2.5rem; }
  .avatar-edit__head { margin-bottom:1.15rem; }
  .avatar-edit__title { margin:0; font-size:1.375rem; letter-spacing:-.01em; }
  .avatar-edit__hint { margin:.2rem 0 0; font-size:var(--fs-sm); color:var(--muted); }
  .listing-uppy { position:relative; z-index:0; border:1px solid var(--line); border-radius:var(--r-sm); overflow:hidden; }
  .avatar-edit__current { display:flex; align-items:center; gap:.85rem; margin:0 0 1rem; padding:.6rem .75rem; border:1px solid var(--line); border-radius:var(--r-sm); }
  .avatar-edit__thumb { width:56px; height:56px; border-radius:50%; object-fit:cover; flex:none; background:var(--surface-2); }
  .avatar-edit__currentlabel { font-size:var(--fs-sm); color:var(--muted); }
  .avatar-edit__current form { margin:0 0 0 auto; }

  .account-form { max-width:680px; }
  .account-form__row { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
  .account-form__actions { margin-top:.5rem; }
  @media (max-width:560px){ .account-form__row { grid-template-columns:1fr; } }
</style>
