---
slug: account/photo/delete
method: post
authorization_policies: [require_login]
---
{%- liquid
  assign me = context.current_user.id | append: ''
  graphql ex = 'photos/search', object_uuid: me, photo_type: 'profile'
  for old in ex.photos.results
    graphql d = 'photos/delete', id: old.id
  endfor
  redirect_to '/account?saved=1'
-%}
