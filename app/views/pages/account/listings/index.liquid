---
metadata:
  title: My listings
authorization_policies: [require_host]
---
{%- liquid
  assign page_num = context.params.page | default: 1 | plus: 0
  graphql g = 'listings/get_by_user', host_id: context.current_user.id, per_page: 25, page: page_num
  assign rs = g.records
  assign listings = rs.results

  assign n_pub = 0
  for l in listings
    assign st = l.status | default: 'draft'
    if st == 'published'
      assign n_pub = n_pub | plus: 1
    endif
  endfor

  assign summary = ''
  if rs.total_pages <= 1 and listings != blank
    if n_pub == rs.total_entries
      assign summary = 'all published'
    elsif n_pub == 0
      assign summary = 'none published yet'
    else
      assign summary = n_pub | append: ' published'
    endif
  endif
-%}
<div>
  <div class="page-head">
    <div class="page-head__text">
      <h1>My listings</h1>
      {% if listings != blank %}
        <p class="page-head__meta">{{ rs.total_entries }} {% if rs.total_entries == 1 %}listing{% else %}listings{% endif %}{% if summary != blank %} &middot; {{ summary }}{% endif %}</p>
      {% endif %}
    </div>
    <form class="page-head__action" action="/account/listings/new" method="post">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <button class="btn btn--primary btn--cta" type="submit">+ New listing</button>
    </form>
  </div>

  {% if context.params.published %}
    <div class="flash flash--notice">Your listing is live.</div>
  {% elsif context.params.error == 'create' %}
    <div class="flash flash--alert">Couldn’t start a new listing — please try again.</div>
  {% endif %}

  {% if listings == blank %}
    <div class="listings-empty">
      <h2>No listings yet</h2>
      <p class="muted">Create your first space to start reaching renters.</p>
      <form action="/account/listings/new" method="post" style="margin-top:1rem;">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <button class="btn btn--primary btn--cta" type="submit">Create a listing</button>
      </form>
    </div>
  {% else %}
    <table class="mylistings">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Type</th>
          <th>City</th>
          <th>Status</th>
          <th class="mylistings__actions-cell">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for l in listings %}
          {%- assign l_cover = l.covers.first -%}
          <tr>
            <td class="mylistings__thumb-cell">
              {%- if l_cover.photo -%}
                <img class="mylistings__thumb" src="{{ l_cover.photo.versions.sm | default: l_cover.photo.url }}" alt="" loading="lazy" width="74" height="56">
              {%- else -%}
                <span class="mylistings__thumb img-ph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="15" rx="1.5"/><circle cx="8" cy="10" r="1.6"/><path d="M21 15.5l-4.6-4.6L7 20.5"/></svg>
                </span>
              {%- endif -%}
            </td>
            <td class="mylistings__title-cell"><a href="/account/listings/{{ l.id }}/edit">{{ l.title | default: 'Untitled listing' }}</a></td>
            <td>{{ l.listing_type | default: '—' }}</td>
            <td>{{ l.city | default: '—' }}</td>
            <td><span class="status-pill status-pill--{{ l.status | default: 'draft' }}">{{ l.status | default: 'draft' }}</span></td>
            <td class="mylistings__actions-cell">
              <div class="mylistings__actions">
                <a class="btn btn--ghost" href="/account/listings/{{ l.id }}/edit">Edit</a>
                <form action="/account/listings/{{ l.id }}/delete" method="post" onsubmit="return confirm('Delete this listing?');" style="display:inline;">
                  <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
                  <button class="btn btn--danger" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if rs.total_pages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {% if rs.has_previous_page %}<a class="btn btn--ghost" href="?page={{ rs.current_page | minus: 1 }}">← Previous</a>{% endif %}
        <span class="muted">Page {{ rs.current_page }} of {{ rs.total_pages }}</span>
        {% if rs.has_next_page %}<a class="btn btn--ghost" href="?page={{ rs.current_page | plus: 1 }}">Next →</a>{% endif %}
      </nav>
    {% endif %}
  {% endif %}
</div>

<style>
  .mylistings { width: 100%; border-collapse: collapse; }
  .mylistings th, .mylistings td { text-align: left; padding: .9rem .6rem; border-bottom: 1px solid var(--line); font-size: var(--fs-sm); vertical-align: middle; }
  .mylistings th { color: var(--muted); font-weight: 700; font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .07em; padding-bottom: .6rem; }
  .mylistings__title-cell a { font-weight: 700; color: var(--accent-ink); }
  .mylistings__thumb-cell { width: 74px; }
  .mylistings__thumb { width: 74px; height: 56px; border-radius: var(--r-btn); object-fit: cover; display: block; background: var(--surface-2); }
  .mylistings__thumb.img-ph { display: flex; }
  .mylistings__thumb.img-ph svg { width: 20px; height: 20px; }
  .mylistings__actions-cell { text-align: right; white-space: nowrap; }
  .mylistings__actions { display: flex; gap: .5rem; justify-content: flex-end; }
  .mylistings__actions .btn { padding: .45rem .95rem; }
  .listings-empty { text-align: center; padding: 3rem 1rem; border: 1px dashed var(--line); }
  .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2rem; }

  @media (max-width: 640px) {
    .mylistings thead { display: none; }
    .mylistings, .mylistings tbody, .mylistings tr, .mylistings td { display: block; width: 100%; }
    .mylistings tr { border: 1px solid var(--line); margin-bottom: .75rem; padding: .5rem; }
    .mylistings td { border: 0; padding: .35rem .5rem; }
    .mylistings__thumb-cell { width: auto; }
    .mylistings__actions { justify-content: flex-start; }
  }
</style>
