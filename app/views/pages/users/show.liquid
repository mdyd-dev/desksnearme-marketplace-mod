---
slug: users/:id
metadata:
  title: Profile
---
{%- liquid
  assign page_num = context.params.page | default: 1 | plus: 0

  graphql u = 'users/get_user', id: context.params.id
  assign pu = u.user

  graphql p = 'profiles/get_by_user', user_id: context.params.id
  assign prof = p.records.results.first

  graphql pp = 'photos/search', object_uuid: context.params.id, photo_type: 'profile', limit: 1
  assign avatar_url = pp.photos.results.first.photo.versions.m | default: ''

  assign display_name = pu.name | default: pu.first_name | default: 'Member'
  assign company = prof.company_name
  assign bio = prof.bio

  graphql hl = 'listings/get_published_by_user', host_id: context.params.id, per_page: 24, page: page_num
  assign hrs = hl.records
  assign host_listings = hrs.results
  assign space_count = hrs.total_entries
-%}

<a class="listing-detail__back" href="/listings">← Browse spaces</a>

{% if pu == blank %}
  <div class="listings-empty">
    <h1>Profile not found</h1>
    <p class="muted">This profile isn’t available. <a href="/listings">Browse all spaces</a>.</p>
  </div>
{% else %}
  <header class="host-hero">
    {%- assign avatar_name = company | default: display_name -%}
    {% include 'hosts/avatar', name: avatar_name, size: 'lg', image_url: avatar_url %}
    <div class="host-hero__meta">
      <h1>{{ display_name }}</h1>
      {% if company != blank and company != display_name %}<p class="host-hero__company">{{ company }}</p>{% endif %}
      {% if space_count > 0 %}<p class="muted host-hero__count">{{ space_count }} {% if space_count == 1 %}space{% else %}spaces{% endif %} listed</p>{% endif %}
    </div>
  </header>

  {% if bio != blank %}<p class="host-hero__bio">{{ bio }}</p>{% endif %}

  {% if space_count > 0 %}
    <h2 class="host-spaces__title">Spaces by {{ display_name }}</h2>
    <div class="listings-grid">
      {% for l in host_listings %}{% include 'listings/card', listing: l, index: forloop.index, want_am_str: '' %}{% endfor %}
    </div>

    {% if hrs.total_pages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {% if hrs.has_previous_page %}<a class="btn btn--ghost" href="?page={{ hrs.current_page | minus: 1 }}">← Previous</a>{% endif %}
        <span class="muted">Page {{ hrs.current_page }} of {{ hrs.total_pages }}</span>
        {% if hrs.has_next_page %}<a class="btn btn--ghost" href="?page={{ hrs.current_page | plus: 1 }}">Next →</a>{% endif %}
      </nav>
    {% endif %}
  {% endif %}
{% endif %}

<style>
  .host-hero { display: flex; align-items: center; gap: 1.5rem; margin: 1rem 0 1.25rem; }
  .host-hero__meta h1 { margin: 0 0 .2rem; }
  .host-hero__company { font-size: var(--fs-md); color: var(--ink); margin: 0 0 .25rem; }
  .host-hero__count { margin: 0; }
  .host-hero__bio { max-width: 60ch; margin: 0 0 2rem; white-space: pre-line; }
  .host-spaces__title { font-size: var(--fs-lg); margin: 0 0 1.25rem; }

  .avatar { display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface-2); color: #fff; font-family: var(--font-display); font-weight: 600; object-fit: cover; flex: none; overflow: hidden; }
  .avatar--lg { width: 88px; height: 88px; font-size: var(--fs-xl); }

  .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.75rem 1.25rem; }
  .listing-card { display: flex; flex-direction: column; background: transparent; border: 0; border-radius: 0; overflow: visible; box-shadow: none; }
  .listing-card:hover { text-decoration: none; }
  .listing-card:hover .listing-card__media { box-shadow: var(--shadow-2); }
  .listing-card__media { position: relative; aspect-ratio: 1 / 1; border-radius: var(--r-lg); background: var(--surface-2); overflow: hidden; transition: box-shadow .15s ease; }
  .listing-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .listing-card__badge { position: absolute; top: .6rem; left: .6rem; z-index: 1; font-size: var(--fs-xs); font-weight: 600; color: #fff; background: var(--accent); padding: .2rem .55rem; border-radius: var(--r-pill); }
  .listing-card__body { padding: .65rem 0 0; }
  .listing-card__title { font-size: var(--fs-sm); font-weight: 700; margin: 0 0 .1rem; color: var(--ink); }
  .listing-card__loc { font-size: var(--fs-sm); color: var(--muted); margin: 0 0 .3rem; }
  .listing-card__price { font-weight: 700; color: var(--ink); margin: 0; font-size: var(--fs-sm); }
  .listing-card__price span { font-weight: 500; color: var(--muted); }

  .pagination { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-top: 2.5rem; }

  @media (max-width: 560px) {
    .host-hero { gap: 1rem; }
    .avatar--lg { width: 68px; height: 68px; }
  }
</style>
