---
method: post
---
{% liquid
  graphql result = 'users/verify_password', email: context.params.email, password: context.params.password
  assign u = result.users.results.first
  if u.authenticate.password
    graphql prof = 'profiles/get_by_user', user_id: u.id
    assign confirmed_at = prof.records.results.first.confirmed_at
    if confirmed_at == blank
      redirect_to '/?login_error=unconfirmed'
    else
      sign_in user_id: u.id
      redirect_to '/'
    endif
  else
    redirect_to '/?login_error=1'
  endif
%}