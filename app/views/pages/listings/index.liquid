---
metadata:
  title: Browse spaces
  description: Browse desks, meeting rooms, and office space available to rent near you. Filter by space type and location to find the right workspace.
  full_bleed: true
---
{%- liquid
  assign type = context.params.type
  if type == blank or type == 'all'
    assign listing_types = "Desk,Meeting Room,Office Space" | split: ","
  else
    assign listing_types = type | split: "~"
  endif

  assign period = context.params.period
  assign period_prop = ''
  if period == 'hour'
    assign period_prop = 'price_hour'
  elsif period == 'day'
    assign period_prop = 'price_day'
  elsif period == 'week'
    assign period_prop = 'price_week'
  elsif period == 'month'
    assign period_prop = 'price_month'
  endif

  assign near = context.params.near | strip
  assign lat = context.params.lat
  assign lng = context.params.lng
  assign page_num = context.params.page | default: 1 | plus: 0

  assign capacity = 0
  if context.params.capacity != blank
    assign capacity = context.params.capacity | plus: 0
  endif

  assign want_am = context.params.amenities | default: nil
  if want_am == blank
    assign want_am = nil
  endif
  assign want_am_str = want_am | join: '|'
  assign am_count = 0
  if want_am
    assign am_count = want_am | size
  endif

  assign am_on = false
  if am_count > 0
    assign am_on = true
  endif

  assign filters_on = false
  if am_on or capacity > 0 or near != blank or period_prop != blank
    assign filters_on = true
  endif
  unless type == blank or type == 'all'
    assign filters_on = true
  endunless

  assign active_count = am_count
  if capacity > 0
    assign active_count = active_count | plus: 1
  endif
  if period_prop != blank
    assign active_count = active_count | plus: 1
  endif
  unless type == blank or type == 'all'
    assign active_count = active_count | plus: 1
  endunless

  assign mode = 'all'
  if lat != blank and lng != blank
    assign mode = 'geo'
    assign radius_km = context.params.radius | default: 50 | plus: 0
    assign latf = lat | plus: 0.0
    assign lngf = lng | plus: 0.0

    # cosine lookup, 5-degree bands, linearly interpolated.
    # longitude degrees narrow toward the poles, so the lng delta
    # must be divided by cos(latitude) or the box is far too wide.
    assign abs_lat = latf
    if abs_lat < 0
      assign abs_lat = abs_lat | times: -1.0
    endif
    if abs_lat > 85.0
      assign abs_lat = 85.0
    endif
    assign cos_table = "1.000,0.996,0.985,0.966,0.940,0.906,0.866,0.819,0.766,0.707,0.643,0.574,0.500,0.423,0.342,0.259,0.174,0.087" | split: ","
    assign band = abs_lat | divided_by: 5.0 | floor
    assign band_hi = band | plus: 1
    if band_hi > 17
      assign band_hi = 17
    endif
    assign c_lo = cos_table[band] | plus: 0.0
    assign c_hi = cos_table[band_hi] | plus: 0.0
    assign band_lo_deg = band | times: 5.0
    assign frac = abs_lat | minus: band_lo_deg | divided_by: 5.0
    assign cos_lat = c_hi | minus: c_lo | times: frac | plus: c_lo
    if cos_lat < 0.05
      assign cos_lat = 0.05
    endif

    assign lat_delta = radius_km | divided_by: 111.0
    assign lng_delta = radius_km | divided_by: 111.0 | divided_by: cos_lat

    assign lat_min = latf | minus: lat_delta | round: 6 | append: ''
    assign lat_max = latf | plus: lat_delta | round: 6 | append: ''
    assign lng_min = lngf | minus: lng_delta | round: 6 | append: ''
    assign lng_max = lngf | plus: lng_delta | round: 6 | append: ''
  elsif near != blank
    assign mode = 'city'
  endif
-%}
{%- parse_json props -%}
[
  { "name": "status", "value": "published" },
  { "name": "listing_type", "value_in": {{ listing_types | json }} }
  {%- if capacity > 0 -%}
    , { "name": "capacity", "range": { "gte": {{ capacity | append: '' | json }} } }
  {%- endif -%}
  {%- if want_am -%}
    , { "name": "amenities", "array_contains": {{ want_am | json }} }
  {%- endif -%}
  {%- if period_prop != blank -%}
    , { "name": {{ period_prop | json }}, "range": { "gt": "0" } }
  {%- endif -%}
  {%- if mode == 'geo' -%}
    , { "name": "latitude", "range": { "gte": {{ lat_min | json }}, "lte": {{ lat_max | json }} } }
    , { "name": "longitude", "range": { "gte": {{ lng_min | json }}, "lte": {{ lng_max | json }} } }
  {%- elsif mode == 'city' -%}
    , { "name": "city", "contains": {{ near | json }}, "case_sensitive": false }
  {%- endif -%}
]
{%- endparse_json -%}
{%- liquid
  graphql g = 'listings/search', properties: props, per_page: 20, page: page_num
  assign rs = g.records
  assign listings = rs.results

  assign qs = ''
  unless type == blank
    assign qs = qs | append: 'type=' | append: type | append: '&'
  endunless
  if period_prop != blank
    assign qs = qs | append: 'period=' | append: period | append: '&'
  endif
  unless near == blank
    assign qs = qs | append: 'near=' | append: near | url_encode | append: '&'
  endunless
  if capacity > 0
    assign qs = qs | append: 'capacity=' | append: capacity | append: '&'
  endif
  if want_am
    for am in want_am
      assign qs = qs | append: 'amenities[]=' | append: am | append: '&'
    endfor
  endif
  if lat != blank and lng != blank
    assign qs = qs | append: 'lat=' | append: lat | append: '&lng=' | append: lng | append: '&'
  endif
-%}
{%- parse_json map_points -%}
[
{%- assign first = true -%}
{%- for l in listings -%}
  {%- if l.latitude != blank and l.longitude != blank -%}
    {%- unless first %},{% endunless -%}
    {%- assign pr = '' -%}
    {%- if l.price_hour -%}
      {%- assign pr = l.price_hour | advanced_format: '%.2f' | prepend: '$' | append: ' / hour' -%}
    {%- elsif l.price_day -%}
      {%- assign pr = l.price_day | advanced_format: '%.2f' | prepend: '$' | append: ' / day' -%}
    {%- elsif l.price_week -%}
      {%- assign pr = l.price_week | advanced_format: '%.2f' | prepend: '$' | append: ' / week' -%}
    {%- elsif l.price_month -%}
      {%- assign pr = l.price_month | advanced_format: '%.2f' | prepend: '$' | append: ' / month' -%}
    {%- endif -%}
    {%- assign pt_lat = l.latitude -%}
    {%- assign pt_lng = l.longitude -%}
    {%- assign pt_fuzzy = false -%}
    {%- if l.location_precision == 'general' -%}
      {%- assign pt_lat = l.latitude | round: 2 -%}
      {%- assign pt_lng = l.longitude | round: 2 -%}
      {%- assign pt_fuzzy = true -%}
    {%- endif -%}
    {%- capture pt_url %}{% render 'listings/url', id: l.id, title: l.title %}{% endcapture -%}
    {
      "lat": {{ pt_lat | json }},
      "lng": {{ pt_lng | json }},
      "title": {{ l.title | json }},
      "price": {{ pr | json }},
      "url": {{ pt_url | json }}
      {%- if pt_fuzzy -%}, "fuzzy": true{%- endif -%}
    }
    {%- assign first = false -%}
  {%- endif -%}
{%- endfor -%}
]
{%- endparse_json -%}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<div class="browse">
  <section class="browse__list">
    <div class="browse__list-inner">
      <div class="browse__head">
        <h1>
          {%- if mode == 'geo' -%}Spaces near {{ near | default: 'you' }}
          {%- elsif mode == 'city' -%}Spaces in “{{ near }}”
          {%- else -%}All spaces{%- endif -%}
        </h1>
        <p class="muted">{{ rs.total_entries }} {% if rs.total_entries == 1 %}space{% else %}spaces{% endif %} found</p>
      </div>

      <form class="browse__filters" action="/listings" method="get" role="search">
        <input type="hidden" name="lat" id="near-lat" value="{{ lat }}">
        <input type="hidden" name="lng" id="near-lng" value="{{ lng }}">

        <div class="usearch place-search">
          <div class="usearch__where">
            <label class="usearch__lbl" for="near-input">Where</label>
            <input id="near-input" type="text" name="near" value="{{ near }}"
                   class="usearch__input"
                   placeholder="City, area, or address" aria-label="Where"
                   autocomplete="off" spellcheck="false"
                   role="combobox" aria-expanded="false" aria-autocomplete="list"
                   aria-controls="near-list"
                   data-place-input
                   data-lat-field="near-lat" data-lng-field="near-lng">
          </div>
          <span class="usearch__div" aria-hidden="true"></span>
          <button type="button" class="usearch__filters{% if filters_on %} is-on{% endif %}" data-open-filters aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            <span class="usearch__filters-txt">Filters</span>
            {% if active_count > 0 %}<span class="usearch__count">{{ active_count }}</span>{% endif %}
          </button>
          <button type="submit" class="usearch__go" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          </button>
          <ul class="addr-list" id="near-list" role="listbox" hidden></ul>
        </div>

        {%- liquid
          capture am_raw
            render 'listings/amenities_json'
          endcapture
          assign am_groups = am_raw | parse_json
        -%}
        <dialog class="filters-modal" data-filters-modal aria-label="Filters">
          <div class="filters-modal__head">
            <button type="button" class="filters-modal__close" data-close-filters aria-label="Close filters">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
            <h2 class="filters-modal__title">Filters</h2>
          </div>

          <div class="filters-modal__body">
            <section class="filters-sec">
              <h3 class="filters-sec__h">Type of space</h3>
              <div class="filters-sec__chips">
                <label class="chip"><input type="radio" name="type" value="all"{% if type == blank or type == 'all' %} checked{% endif %}><span>Any type</span></label>
                <label class="chip"><input type="radio" name="type" value="Desk"{% if type == 'Desk' %} checked{% endif %}><span>Desk</span></label>
                <label class="chip"><input type="radio" name="type" value="Meeting Room"{% if type == 'Meeting Room' %} checked{% endif %}><span>Meeting room</span></label>
                <label class="chip"><input type="radio" name="type" value="Office Space"{% if type == 'Office Space' %} checked{% endif %}><span>Office space</span></label>
              </div>
            </section>

            <section class="filters-sec">
              <h3 class="filters-sec__h">Rental period</h3>
              <p class="filters-sec__hint">Show spaces that offer this rate.</p>
              <div class="filters-sec__chips">
                <label class="chip"><input type="radio" name="period" value="all"{% if period == blank or period == 'all' %} checked{% endif %}><span>Any</span></label>
                <label class="chip"><input type="radio" name="period" value="hour"{% if period == 'hour' %} checked{% endif %}><span>Hour</span></label>
                <label class="chip"><input type="radio" name="period" value="day"{% if period == 'day' %} checked{% endif %}><span>Day</span></label>
                <label class="chip"><input type="radio" name="period" value="week"{% if period == 'week' %} checked{% endif %}><span>Week</span></label>
                <label class="chip"><input type="radio" name="period" value="month"{% if period == 'month' %} checked{% endif %}><span>Month</span></label>
              </div>
            </section>

            <section class="filters-sec">
              <h3 class="filters-sec__h">People</h3>
              <p class="filters-sec__hint">The minimum number the space should fit.</p>
              <div class="stepper" data-stepper>
                <button type="button" class="stepper__btn" data-step="-1" aria-label="Fewer people">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg>
                </button>
                <span class="stepper__val" data-stepper-label>{% if capacity > 0 %}{{ capacity }}+{% else %}Any{% endif %}</span>
                <button type="button" class="stepper__btn" data-step="1" aria-label="More people">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                </button>
                <input type="hidden" name="capacity" value="{% if capacity > 0 %}{{ capacity }}{% endif %}" data-stepper-input>
              </div>
            </section>

            <section class="filters-sec">
              <h3 class="filters-sec__h">Amenities</h3>
              {%- for g in am_groups -%}
                <div class="amx__group">
                  <p class="amx__grouph">{{ g.group }}</p>
                  <div class="amx__chips">
                    {%- for a in g.items -%}
                      {%- assign on = false -%}
                      {%- if want_am_str contains a.slug -%}{%- assign on = true -%}{%- endif -%}
                      <label class="fchip">
                        <input type="checkbox" name="amenities[]" value="{{ a.slug }}"{% if on %} checked{% endif %}>
                        <span class="fchip__box">{% render 'listings/amenity_icon', slug: a.slug %}{{ a.label }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </section>
          </div>

          <div class="filters-modal__foot">
            <button type="button" class="filters-modal__clear" data-clear-filters>Clear all</button>
            <button type="submit" class="btn btn--primary filters-modal__apply">Show results</button>
          </div>
        </dialog>
      </form>

      {% if listings == blank %}
        <div class="listings-empty">
          <h2>No spaces found</h2>
          <p class="muted">
            {% if mode == 'city' %}Nothing listed in “{{ near }}” yet. {% endif %}Try a different area, or <a href="/listings">browse all spaces</a>.
          </p>
        </div>
      {% else %}
        <div class="listings-grid"
             id="listings-grid"
             {% if mode == 'geo' %}data-origin-lat="{{ lat }}" data-origin-lng="{{ lng }}"{% endif %}>
          {% for l in listings %}{% include 'listings/card', listing: l, index: forloop.index, want_am_str: want_am_str %}{% endfor %}
        </div>

        {% if rs.total_pages > 1 %}
          <nav class="pagination" aria-label="Pagination">
            {% if rs.has_previous_page %}<a class="btn btn--ghost" href="?{{ qs }}page={{ rs.current_page | minus: 1 }}">← Previous</a>{% endif %}
            <span class="muted">Page {{ rs.current_page }} of {{ rs.total_pages }}</span>
            {% if rs.has_next_page %}<a class="btn btn--ghost" href="?{{ qs }}page={{ rs.current_page | plus: 1 }}">Next →</a>{% endif %}
          </nav>
        {% endif %}
      {% endif %}
    </div>
  </section>

  <aside class="browse__map" aria-label="Map of results">
    <div class="map-ph" id="listings-map"
         data-geo-map
         data-scroll-zoom="always"
         data-map-key="{{ context.constants.geoapify_map_key }}"
         data-points-from="listings-map-data">
      <svg class="map-ph__pin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      <p class="map-ph__addr">Map view</p>
      <p class="map-ph__note">No mapped spaces in these results</p>
    </div>
  </aside>
</div>

<script type="application/json" id="listings-map-data">{{ map_points | json | replace: '</', '<\/' | html_safe }}</script>

<style>
  .page--full { padding-block: 0; }

  .browse__list-inner { padding: 1.75rem clamp(1.25rem, 3vw, 2.5rem) 3rem; }
  .browse__head h1 { margin: 0 0 .2rem; }
  .browse__head p { margin: 0; }

  .browse__filters { margin: 1.15rem 0 1.7rem; }
  .usearch { position: relative; display: flex; align-items: center; max-width: 560px; background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--r-pill); padding: 4px; transition: border-color .12s ease, box-shadow .12s ease; }
  .usearch:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 15%, transparent); }
  .usearch__where { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; padding: 3px 16px; }
  .usearch__lbl { font-size: 11px; font-weight: 700; color: var(--ink); margin: 0 0 1px; cursor: text; }
  .usearch__input { width: 100%; border: 0; background: transparent; padding: 0; margin: 0; font: inherit; font-size: var(--fs-sm); color: var(--ink); }
  .usearch__input::placeholder { color: var(--muted); }
  .usearch__input:focus { outline: none; }
  .usearch__div { flex: none; width: 1px; height: 28px; background: var(--line); }
  .usearch__filters { display: inline-flex; align-items: center; gap: .4rem; flex: none; height: 40px; margin: 0 .15rem; padding: 0 .95rem; border: 0; border-radius: var(--r-pill); background: none; font: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--ink); white-space: nowrap; cursor: pointer; transition: background .12s ease; }
  .usearch__filters:hover { background: var(--surface-2); }
  .usearch__filters svg { width: 17px; height: 17px; }
  .usearch__filters.is-on { color: var(--accent-ink); }
  .usearch__count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--accent); color: var(--charcoal); font-size: var(--fs-xs); font-weight: 700; }
  .usearch__go { flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--accent); color: var(--charcoal); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .12s ease, color .12s ease; }
  .usearch__go:hover { background: var(--accent-hover); color: #fff; }
  .usearch__go svg { width: 18px; height: 18px; }

  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip > span { display: inline-flex; align-items: center; height: 36px; white-space: nowrap; font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--r-pill); padding: 0 .95rem; cursor: pointer; transition: border-color .12s ease, background .12s ease; }
  .chip:hover > span { border-color: var(--accent); }
  .chip input:checked + span { color: var(--accent-ink); font-weight: 600; background: color-mix(in srgb, var(--accent) 12%, #fff); border-color: var(--accent); }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip__sm { display: none; }

  .filters-modal { padding: 0; border: 0; border-radius: 16px; width: 560px; max-width: calc(100vw - 2rem); max-height: 85vh; background: #fff; color: var(--ink); box-shadow: var(--shadow-2); overflow: hidden; }
  .filters-modal::backdrop { background: rgba(12, 13, 15, .5); }
  .filters-modal[open] { display: flex; flex-direction: column; }
  .filters-modal__head { position: relative; display: flex; align-items: center; justify-content: center; padding: .9rem 1rem; border-bottom: 1px solid var(--line); flex: none; }
  .filters-modal__title { margin: 0; font-size: var(--fs-md); font-weight: 700; }
  .filters-modal__close { position: absolute; left: .7rem; top: 50%; transform: translateY(-50%); border: 0; background: none; color: var(--ink); cursor: pointer; padding: .3rem; display: inline-flex; border-radius: 50%; }
  .filters-modal__close:hover { background: var(--surface-2); }
  .filters-modal__close svg { width: 18px; height: 18px; }
  .filters-modal__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 1.5rem; }
  .filters-modal__foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1.25rem; border-top: 1px solid var(--line); flex: none; }
  .filters-modal__clear { border: 0; background: none; color: var(--ink); font: inherit; font-size: var(--fs-sm); font-weight: 600; text-decoration: underline; cursor: pointer; padding: 0; }
  .filters-modal__apply { padding: .6rem 1.4rem; }

  .filters-sec { padding: 0 0 1.5rem; margin: 0 0 1.5rem; border-bottom: 1px solid var(--line); }
  .filters-sec:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .filters-sec__h { font-size: var(--fs-md); font-weight: 700; margin: 0 0 .9rem; }
  .filters-sec__hint { font-size: var(--fs-sm); color: var(--muted); margin: -.6rem 0 .9rem; }
  .filters-sec__chips { display: flex; flex-wrap: wrap; gap: .5rem; }

  .stepper { display: inline-flex; align-items: center; gap: 1.1rem; }
  .stepper__btn { width: 38px; height: 38px; border: 1.5px solid var(--line); border-radius: 50%; background: var(--surface); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: border-color .12s ease, color .12s ease; }
  .stepper__btn:hover { border-color: var(--accent); color: var(--accent-ink); }
  .stepper__btn svg { width: 16px; height: 16px; }
  .stepper__val { min-width: 3.5rem; text-align: center; font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
  .amx__group { margin-bottom: 1.15rem; }
  .amx__group:last-child { margin-bottom: 0; }
  .amx__grouph { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; margin: 0 0 .55rem; }
  .amx__chips { display: flex; flex-wrap: wrap; gap: .5rem; }
  .fchip { position: relative; display: inline-flex; }
  .fchip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .fchip__box { display: inline-flex; align-items: center; gap: .45rem; height: 36px; white-space: nowrap; font-size: var(--fs-sm); color: var(--ink); background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--r-pill); padding: 0 .9rem; cursor: pointer; transition: border-color .12s ease, background .12s ease; }
  .fchip__icon { width: 16px; height: 16px; flex: none; color: var(--muted); }
  .fchip input:checked + .fchip__box .fchip__icon { color: var(--accent-ink); }
  .fchip:hover .fchip__box { border-color: var(--accent); }
  .fchip input:checked + .fchip__box { color: var(--accent-ink); font-weight: 600; background: color-mix(in srgb, var(--accent) 12%, #fff); border-color: var(--accent); }
  .fchip input:focus-visible + .fchip__box { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 620px) {
    .usearch { max-width: none; }
    .usearch__lbl { display: none; }
    .usearch__filters-txt { display: none; }
    .usearch__filters { padding: 0 .55rem; margin: 0; }
    .filters-modal { width: 100%; max-width: 100%; height: 100%; max-height: 100%; border-radius: 0; }
    .filters-modal__apply { flex: 1; }
