<script>
  (function () {
    var modal = document.querySelector('[data-filters-modal]');
    var openBtn = document.querySelector('[data-open-filters]');
    if (!modal || !openBtn || !modal.showModal) return;

    openBtn.addEventListener('click', function () {
      modal.showModal();
      document.body.style.overflow = 'hidden';
    });
    modal.addEventListener('close', function () { document.body.style.overflow = ''; });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) { modal.close(); return; }
      if (e.target.closest('[data-close-filters]')) { modal.close(); return; }
      if (e.target.closest('[data-clear-filters]')) {
        modal.querySelectorAll('input[type="checkbox"]').forEach(function (c) { c.checked = false; });
        var anyType = modal.querySelector('input[name="type"][value="all"]');
        if (anyType) anyType.checked = true;
        var anyPeriod = modal.querySelector('input[name="period"][value="all"]');
        if (anyPeriod) anyPeriod.checked = true;
        var si = modal.querySelector('[data-stepper-input]');
        var sl = modal.querySelector('[data-stepper-label]');
        if (si) si.value = '';
        if (sl) sl.textContent = 'Any';
      }
    });

    var stepper = modal.querySelector('[data-stepper]');
    if (stepper) {
      var input = stepper.querySelector('[data-stepper-input]');
      var label = stepper.querySelector('[data-stepper-label]');
      stepper.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-step]');
        if (!btn) return;
        var cur = parseInt(input.value, 10);
        if (isNaN(cur) || cur < 1) cur = 0;
        cur += parseInt(btn.dataset.step, 10);
        if (cur < 1) cur = 0;
        if (cur > 50) cur = 50;
        input.value = cur > 0 ? String(cur) : '';
        label.textContent = cur > 0 ? (cur + '+') : 'Any';
      });
    }
  })();
</script>