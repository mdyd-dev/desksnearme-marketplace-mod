---
slug: api/geo/autocomplete.json
---
{%- liquid
  assign raw = context.params.q | strip
  assign q = raw | downcase | replace: '  ', ' ' | replace: '  ', ' '
  assign qlen = q | size
  assign lang = context.params.lang | default: 'en'
  assign cache_key = lang | append: ':' | append: q

  assign ok = true
  if qlen < 3
    assign ok = false
  endif
  if qlen > 120
    assign ok = false
  endif

  assign cached_payload = ''
  if ok
    graphql cg = 'geo/cache_get', key: cache_key
    assign hit = cg.records.results.first
    if hit
      assign now_ts = 'now' | date: '%s' | plus: 0
      assign made_ts = hit.created_at | date: '%s' | plus: 0
      assign age = now_ts | minus: made_ts
      if age < 2592000
        assign cached_payload = hit.payload
      endif
    endif
  endif
-%}
{%- if ok == false -%}
[]
{%- elsif cached_payload != blank -%}
{{ cached_payload | html_safe }}
{%- else -%}
{%- parse_json ac_data -%}
{
  "text": {{ raw | json }},
  "lang": {{ lang | json }},
  "api_key": {{ context.constants.geoapify_api_key | json }}
}
{%- endparse_json -%}
{%- liquid
  graphql ac = 'api_calls/geoapify_autocomplete', data: ac_data
  assign status = ac.api_call_send.response.status
  assign body = ac.api_call_send.response.body | parse_json
  assign results = body.results
-%}
{%- if status != 200 -%}
[]
{%- else -%}
{%- capture payload -%}
[
{%- for r in results -%}
{
"label": {{ r.formatted | default: '' | json | html_safe }},
"line1": {{ r.address_line1 | default: '' | json | html_safe }},
"line2": {{ r.address_line2 | default: '' | json | html_safe }},
"lat": {{ r.lat | default: 0 | json | html_safe }},
"lon": {{ r.lon | default: 0 | json | html_safe }},
"housenumber": {{ r.housenumber | default: '' | json | html_safe }},
"street": {{ r.street | default: '' | json | html_safe }},
"city": {{ r.city | default: '' | json | html_safe }},
"state": {{ r.state | default: '' | json | html_safe }},
"state_code": {{ r.state_code | default: '' | json | html_safe }},
"postcode": {{ r.postcode | default: '' | json | html_safe }},
"country_code": {{ r.country_code | default: '' | json | html_safe }},
"place_id": {{ r.place_id | default: '' | json | html_safe }},
"result_type": {{ r.result_type | default: '' | json | html_safe }},
"category": {{ r.category | default: '' | json | html_safe }},
"confidence": {{ r.rank.confidence | default: 0 | json | html_safe }},
"confidence_building": {{ r.rank.confidence_building_level | default: 0 | json | html_safe }},
"match_type": {{ r.rank.match_type | default: '' | json | html_safe }}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{%- liquid
  graphql cs = 'geo/cache_set', key: cache_key, payload: payload
-%}
{{ payload | html_safe }}
{%- endif -%}
{%- endif -%}