---
metadata:
  title: Choose a new password
---
{%- liquid
  assign token = context.params.token | strip
  assign valid = false
  if token != blank
    graphql lookup = 'profiles/get_by_reset_token', token: token
    assign prof = lookup.records.results.first
    if prof and prof.reset_sent_at != blank
      assign now_epoch = 'now' | date: '%s' | plus: 0
      assign sent_epoch = prof.reset_sent_at | plus: 0
      assign age = now_epoch | minus: sent_epoch
      if age <= 3600
        assign valid = true
      endif
    endif
  endif
-%}
<section class="container" style="max-width:46ch;padding:3rem 0;">
  <h1>Choose a new password</h1>

  {%- if valid -%}
    {%- if context.params.error == 'mismatch' -%}
      <div class="flash flash--alert">Those passwords didn't match. Please try again.</div>
    {%- elsif context.params.error == 'short' -%}
      <div class="flash flash--alert">Please choose a password with at least 8 characters.</div>
    {%- endif -%}
    <form action="/password/update" method="post" class="stack">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="token" value="{{ token }}">
      <div class="field">
        <label for="rp-password">New password</label>
        <input class="input" id="rp-password" type="password" name="password" required minlength="8" autocomplete="new-password">
      </div>
      <div class="field">
        <label for="rp-confirm">Confirm new password</label>
        <input class="input" id="rp-confirm" type="password" name="password_confirmation" required minlength="8" autocomplete="new-password">
      </div>
      <button class="btn btn--primary btn--block" type="submit">Set new password</button>
    </form>
  {%- else -%}
    <div class="flash flash--alert">This reset link is invalid or has expired.</div>
    <p style="margin-top:1.5rem;">Reset links are good for one hour. <a href="/forgot-password">Request a new one</a>.</p>
  {%- endif -%}
</section>
