{%- liquid
  # Current profile comes from the user module. The helper exports itself, so a
  # page that already called it does not pay for a second lookup.
  if context.current_user
    assign current_profile = context.exports.current_profile
    unless current_profile
      function current_profile = 'modules/user/helpers/current_profile'
    endunless
  endif

  assign roles = current_profile.roles | default: ''
  assign is_host = false
  if roles contains 'host'
    assign is_host = true
  endif

  assign can_view_admin = false
  if current_profile
    function can_view_admin = 'modules/user/helpers/can_do', requester: current_profile, do: 'admin_pages.view', entity: null, access_callback: null
  endif

  assign initials = ''
  assign display_name = 'Account'
  if context.current_user
    assign fi = context.current_user.first_name | default: '' | slice: 0, 1 | upcase
    assign li = context.current_user.last_name | default: '' | slice: 0, 1 | upcase
    assign initials = fi | append: li
    if initials == blank
      assign initials = context.current_user.email | slice: 0, 1 | upcase
    endif
    assign fn = context.current_user.first_name | default: '' | strip
    assign ln = context.current_user.last_name | default: '' | strip
    assign display_name = fn
    if ln != blank
      assign display_name = fn | append: ' ' | append: ln | strip
    endif
    if display_name == blank
      assign display_name = 'Account'
    endif
  endif

  # Restored when near_me_messaging lands: queries/messages/unread_count.
  assign unread_count = 0
  # Restored when near_me_photos lands: profile photo by object_uuid + photo_type.
  assign avatar_url = ''

  assign seo = context.exports.seo
  assign page_title = seo.title | default: context.page.metadata.title | default: 'Find a space'
  assign page_desc = seo.description | default: context.page.metadata.description | default: 'Find and rent desks, meeting rooms, and office space near you on Desks Near Me.'
  assign page_canonical = seo.canonical
  assign full_bleed = context.page.metadata.full_bleed

  assign asset_parts = 'styles/app.css' | asset_url | split: '/'
  assign asset_origin = asset_parts[0] | append: '//' | append: asset_parts[2]
  assign font_url = 'fonts/inter-latin.woff2' | asset_url | split: '?' | first
  assign font_url_display = 'fonts/archivo-latin.woff2' | asset_url | split: '?' | first
-%}
<!DOCTYPE html>
<html lang="en" class="pos-app">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }} | Desks Near Me</title>
  <meta name="description" content="{{ page_desc }}">
  {%- if page_canonical != blank -%}<link rel="canonical" href="{{ page_canonical }}">{%- endif -%}
  <link rel="preconnect" href="{{ asset_origin }}">
  <link rel="preconnect" href="{{ asset_origin }}" crossorigin>
  <link rel="preload" href="{{ font_url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ font_url_display }}" as="font" type="font/woff2" crossorigin>
  <link rel="icon" type="image/svg+xml" href="{{ 'images/logo-short-f.svg' | asset_url }}">

  {%- comment -%}
    common-styling first, our stylesheet after, so our tokens and components win.
    No reset: true. The module README warns against the reset in an existing app,
    and app.css is already a complete design system.

    PERF: init pulls in 17 stylesheets plus easyMDE, highlight.js and uppy on
    every page. Measure and consider loading it only on pages with module UI
    once the port is done.
  {%- endcomment -%}
  {% render 'modules/common-styling/init' %}
  <link rel="stylesheet" href="{{ 'styles/app.css' | asset_url }}">

  <style>
    .nav-messages__count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 16px; height: 16px; padding: 0 4px; margin-left: .4rem;
      border-radius: 999px; background: var(--accent); color: #fff;
      font-size: 10px; font-weight: 700; line-height: 1; vertical-align: middle;
    }
    .user-menu__count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 18px; height: 18px; padding: 0 5px; margin-left: .4rem;
      border-radius: 999px; background: var(--accent); color: #fff;
      font-size: 10px; font-weight: 700; line-height: 1;
    }
    .logout-form { display: contents; }
    .logout-form button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-nav-open="false" data-role="{% if context.current_user %}{% if can_view_admin %}admin{% elsif is_host %}host{% else %}guest{% endif %}{% else %}out{% endif %}">
    <div class="container">
      <a class="brand" href="/" aria-label="Desks Near Me home">
        <img class="brand__logo" src="{{ 'images/logo-long.svg' | asset_url }}" alt="" width="195" height="30">
      </a>

      <button class="nav-toggle" type="button" aria-label="Toggle menu" data-nav-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>

      <div class="nav-auth">
        {%- if context.current_user -%}
          {%- if is_host -%}
            <a class="nav-link" href="/account/listings">List your desk</a>
          {%- endif -%}
          <a class="nav-link nav-messages" href="/messages">Messages{% if unread_count > 0 %}<span class="nav-messages__count" aria-label="{{ unread_count }} unread">{% if unread_count > 9 %}9+{% else %}{{ unread_count }}{% endif %}</span>{% endif %}</a>
          <div class="user-menu" data-open="false">
            <button class="user-menu__trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Account menu" data-user-menu-toggle>
              <span class="user-menu__avatar">{% if avatar_url != blank %}<img src="{{ avatar_url }}" alt="" width="32" height="32">{% else %}{{ initials }}{% endif %}</span>
              <span class="user-menu__name">{{ display_name }}</span>
              <svg class="user-menu__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="user-menu__panel" role="menu">
              <a class="user-menu__item user-menu__item--m" href="/messages" role="menuitem">Messages{% if unread_count > 0 %}<span class="user-menu__count">{{ unread_count }}</span>{% endif %}</a>
              <a class="user-menu__item" href="/account" role="menuitem">Account</a>
              {%- if is_host -%}
                <a class="user-menu__item" href="/account/listings" role="menuitem">My listings</a>
              {%- endif -%}
              <a class="user-menu__item" href="/account/favorites" role="menuitem">Saved spaces</a>
              {%- if can_view_admin -%}
                <a class="user-menu__item" href="/admin" role="menuitem">Admin</a>
              {%- endif -%}
              <div class="user-menu__sep"></div>
              {%- comment -%}
                The user module logs out via DELETE /sessions. A GET logout link
                would be CSRF-able, so this is a form, not an anchor.
              {%- endcomment -%}
              <form class="logout-form" method="post" action="/sessions">
                <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
                <input type="hidden" name="_method" value="delete">
                <button class="user-menu__item" type="submit" role="menuitem">Log out</button>
              </form>
            </div>
          </div>
        {%- else -%}
          {%- comment -%}
            Plain links to the module's own forms for now. The signup and login
            modals come back with the role-aware signup endpoint.
          {%- endcomment -%}
          <a class="nav-link" href="/users/new">List your desk</a>
          <a class="nav-link" href="/users/new">Sign up</a>
          <a class="btn btn--primary nav-login" href="/sessions/new">Log in</a>
        {%- endif -%}
      </div>
    </div>
  </header>

  <main id="main" class="page{% if full_bleed %} page--full{% endif %}">
    {%- if full_bleed -%}
      {%- if context.flash.alert or context.flash.notice -%}
        <div class="container">
          {%- if context.flash.alert -%}<div class="flash flash--alert">{{ context.flash.alert }}</div>{%- endif -%}
          {%- if context.flash.notice -%}<div class="flash flash--notice">{{ context.flash.notice }}</div>{%- endif -%}
        </div>
      {%- endif -%}
      {{ content_for_layout }}
    {%- else -%}
      <div class="container">
        {%- if context.flash.alert -%}<div class="flash flash--alert">{{ context.flash.alert }}</div>{%- endif -%}
        {%- if context.flash.notice -%}<div class="flash flash--notice">{{ context.flash.notice }}</div>{%- endif -%}
        {{ content_for_layout }}
      </div>
    {%- endif -%}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Desks Near Me home">
            <img class="brand__logo" src="{{ 'images/logo-long.svg' | asset_url }}" alt="" width="195" height="30">
          </a>
          <p class="footer-tagline">Rent desks, meeting rooms, and offices near you, by the hour, day, week, or month.</p>
        </div>
        <nav class="footer-cols" aria-label="Footer">
          <div class="footer-col">
            <h3>Guests</h3>
            <a href="/listings">Browse spaces</a>
            <a href="/support">Guest Support</a>
          </div>
          <div class="footer-col">
            <h3>Hosts</h3>
            <a href="/account/listings">List your space</a>
            <a href="/support">Host Support</a>
          </div>
          <div class="footer-col">
            <h3>DesksNearMe</h3>
            <a href="/about">About</a>
            <a href="/faq">FAQ</a>
            <a href="/terms">Terms of use</a>
            <a href="/privacy">Privacy</a>
          </div>
        </nav>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">&copy; {{ 'now' | date: '%Y' }} Desks Near Me. All rights reserved.</div>
        <p class="footer-note">Made for flexible work.</p>
      </div>
    </div>
  </footer>

  {%- comment -%}
    Module flash. The user module writes messages here via
    modules/user/helpers/flash, so module pages need this to say anything.
  {%- endcomment -%}
  {%- liquid
    function mflash = 'modules/core/commands/session/get', key: 'sflash', clear: null
    if context.location.pathname != mflash.from or mflash.force_clear
      function _ = 'modules/core/commands/session/clear', key: 'sflash'
    endif
    render 'modules/common-styling/toasts', autohide: null, delay: null, message: mflash.message, severity: mflash.severity
  -%}

  <script>
    (function () {
      var header = document.querySelector('.site-header');
      var toggle = document.querySelector('[data-nav-toggle]');
      if (toggle) toggle.addEventListener('click', function () {
        header.dataset.navOpen = header.dataset.navOpen === 'true' ? 'false' : 'true';
      });
      var userMenu = document.querySelector('.user-menu');
      var umToggle = document.querySelector('[data-user-menu-toggle]');
      function closeUserMenu() {
        if (!userMenu) return;
        userMenu.dataset.open = 'false';
        if (umToggle) umToggle.setAttribute('aria-expanded', 'false');
      }
      if (umToggle && userMenu) {
        umToggle.addEventListener('click', function (e) {
          e.stopPropagation();
          var open = userMenu.dataset.open === 'true';
          userMenu.dataset.open = open ? 'false' : 'true';
          umToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        });
        document.addEventListener('click', function (e) {
          if (userMenu.dataset.open === 'true' && !userMenu.contains(e.target)) closeUserMenu();
        });
      }
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeUserMenu();
      });
    })();

    (function () {
      // let people dismiss any flash message
      document.querySelectorAll('.flash').forEach(function (f) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'flash__close';
        b.setAttribute('aria-label', 'Dismiss');
        b.innerHTML = '&times;';
        b.addEventListener('click', function () { f.remove(); });
        f.appendChild(b);
      });
    })();
  </script>
</body>
</html>
