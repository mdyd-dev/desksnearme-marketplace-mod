{% comment %}
  RBAC for Desks Near Me. Override of
  modules/user/public/lib/queries/role_permissions/permissions.liquid, which the
  user module's own setup instructions require every application to provide.

  Three product roles. A visitor picks guest or host at signup; admin is
  assigned separately.

  Note on `users.register`: it is granted to nobody, deliberately. That
  permission is what gates the module's own /users/new and POST /users pages,
  and those pages cannot take a guest-or-host choice: they always fall back to
  USER_DEFAULT_ROLE, so a host registering there would silently become a guest.
  Withholding it closes that path and leaves exactly one way to sign up, our
  own endpoint, which is also where the anti-spam checks will live. Closing it
  by permission rather than by overriding the module's pages means nothing to
  re-diff on upgrade.

  `signup.create` is ours and gates our own signup pages instead.

  `admin` is given explicit permissions rather than being aliased to
  `superadmin`, because superadmin short-circuits every can_do check. Keep one
  real superadmin account as break-glass instead.
{% endcomment %}
{% liquid
  assign data = {
    "anonymous": ["sessions.create", "signup.create"],
    "authenticated": ["sessions.destroy", "profile.manage"],
    "guest": ["listings.view", "favorites.manage", "messages.manage.own"],
    "host": ["listings.view", "favorites.manage", "messages.manage.own", "listings.manage.own", "photos.manage.own"],
    "admin": ["admin_pages.view", "admin.users.manage", "listings.manage.all", "messages.manage.all"],
    "superadmin": ["users.impersonate_superadmin"]
  }

  assign default_role = context.constants.USER_DEFAULT_ROLE
  if default_role != blank and data[default_role] == null
    assign data[default_role] = []
  endif

  return data
%}
